# Every setting the board resolves, one per line, marked with where its value came from:
#   file     written in config.toml and used as written
#   file*    written in config.toml, but the board uses a different value (the file's follows)
#   default  not in config.toml; filled from the built-in default
#   ignored  written in config.toml, but no setting reads it
default  adopt_sockets = []
default  children.auto_archive_after = "30m0s"
default  editor = ""
default  extensions = {}
default  integrations.github.enabled = <unset>
default  integrations.linear.enabled = <unset>
default  log.file = ""
default  log.level = ""
default  log.max_backups = 0
default  log.max_size_mb = 0
default  log.max_total_mb = 0
default  log.no_compress = false
default  name_sweep_pace = "3s"
default  poll_interval = "2s"
default  tmux_socket = ""
default  tools.claude.account_command = ""
default  tools.claude.account_env = ""
default  tools.claude.account_secret = ""
default  tools.claude.accounts_command = ""
default  tools.claude.activity_cutoff = "(?m)^❯"
default  tools.claude.arrow_dialog_line = "(?i)\\x{B7} [^\\x{B7}\\n]*(?:Arrow keys|\\x{2190}|\\x{2192})[^\\x{B7}\\n]* to navigate\\b"
default  tools.claude.blocked_line = "Interrupted ·"
default  tools.claude.busy_line = "^[✻✳✶✽✢·✦✧+*] Waiting for \\d+ (?:background agents?|dynamic workflows?)"
default  tools.claude.chrome_line = "^\\s*[─q]{4,}.*$|^[\\s─q]*$|^\\s*✔ Update installed\\b.*$"
default  tools.claude.command = "claude"
default  tools.claude.default_status = "idle"
default  tools.claude.dialog_step_entry = "[\\x{2610}-\\x{2612}\\x{2714}]"
default  tools.claude.dialog_step_row = "^[ \\x{A0}]*\\x{2190}[ \\x{A0}].*[ \\x{A0}]\\x{2192}[ \\x{A0}]*$"
default  tools.claude.echo_budget = "0s"
default  tools.claude.fork_command = "claude --resume {id} --fork-session --session-id {new_id} --name {name}"
default  tools.claude.fork_dialog_keys = ["Down", "Enter"]
default  tools.claude.fork_dialog_option = "Resume full session as-is"
default  tools.claude.input_line = ""
default  tools.claude.interrupt_keys = ["Escape"]
default  tools.claude.jump_to_bottom_key = "C-End"
default  tools.claude.limit_line = "(?m)You've hit your .+limit"
default  tools.claude.mcp = ""
default  tools.claude.model_flag = "--model"
default  tools.claude.models = ["sonnet", "sonnet[1m]", "opus", "opus[1m]", "haiku"]
default  tools.claude.models_command = ""
default  tools.claude.prompt_flag = ""
default  tools.claude.prompt_mode = ""
default  tools.claude.rename_command = "/rename"
default  tools.claude.resume_by_id_command = "claude --resume {id}"
default  tools.claude.revive_command = "claude --continue"
default  tools.claude.rules[0].pattern = "(?m)^[ \\x{A0}\\x{2502}|]*(?:[^\\n]*[,\\x{B7}][ \\x{A0}]*)?Enter to confirm(?:[ \\x{A0}]*[,\\x{B7}][^\\n]*)?[ \\x{A0}\\x{2502}|]*$"
default  tools.claude.rules[0].state = "waiting"
default  tools.claude.rules[1].pattern = "(?m)^[ \\x{A0}]*❯[ \\x{A0}]+\\d+\\."
default  tools.claude.rules[1].state = "waiting"
default  tools.claude.rules[2].pattern = "(?m)^[ \\x{A0}]*Enter to select \\x{B7} (?:[^\\x{B7}\\n]+\\x{B7} )*Esc to cancel[ \\x{A0}]*$"
default  tools.claude.rules[2].state = "waiting"
default  tools.claude.rules[3].pattern = "(?m)^[ \\x{A0}]*Ready to submit your answers\\?[ \\x{A0}]*$"
default  tools.claude.rules[3].state = "waiting"
default  tools.claude.rules[4].pattern = "(?m)^[✻✳✶✽✢·✦✧+*] \\S+… \\("
default  tools.claude.rules[4].state = "working"
default  tools.claude.rules[5].pattern = "esc to interrupt"
default  tools.claude.rules[5].state = "working"
default  tools.claude.rules[6].pattern = "(?im)^\\s*error:"
default  tools.claude.rules[6].state = "errored"
default  tools.claude.scrolled_line = "Jump to bottom \\(ctrl\\+End\\)"
default  tools.claude.session_id_flag = "--session-id"
default  tools.claude.session_store = ""
default  tools.claude.shell = false
default  tools.claude.skip_rename_directive = false
default  tools.claude.status_source = "claude-hooks"
default  tools.claude.trailing_note = "^※"
default  tools.claude.turn_end = "^[✻✳✶✽✢·✦✧+*] \\S+ for \\d.*$"
default  tools.claude.type_ahead = true
default  tools.codex.account_command = ""
default  tools.codex.account_env = ""
default  tools.codex.account_secret = ""
default  tools.codex.accounts_command = ""
default  tools.codex.activity_cutoff = "(?m)^(?:[ \\t\\x{2800}-\\x{28ff}]*\\n)*›"
default  tools.codex.arrow_dialog_line = ""
default  tools.codex.blocked_line = ""
default  tools.codex.busy_line = ""
default  tools.codex.chrome_line = "^\\s*─*\\s*$|^⚠ (?:The \\S+ MCP server is not logged in\\. Run \\x60codex mcp login \\S+\\x60\\.|MCP startup incomplete \\(failed: [^)]+\\))$"
default  tools.codex.command = "codex"
default  tools.codex.default_status = "idle"
default  tools.codex.dialog_step_entry = ""
default  tools.codex.dialog_step_row = ""
default  tools.codex.echo_budget = "90ms"
default  tools.codex.fork_command = "codex fork {id}"
default  tools.codex.fork_dialog_keys = []
default  tools.codex.fork_dialog_option = ""
default  tools.codex.input_line = "^›"
default  tools.codex.interrupt_keys = []
default  tools.codex.jump_to_bottom_key = ""
default  tools.codex.limit_line = "(?m)You've hit your usage limit"
default  tools.codex.mcp = ""
default  tools.codex.model_flag = "--model"
default  tools.codex.models = []
default  tools.codex.models_command = ""
default  tools.codex.prompt_flag = ""
default  tools.codex.prompt_mode = ""
default  tools.codex.rename_command = ""
default  tools.codex.resume_by_id_command = "codex resume {id}"
default  tools.codex.revive_command = "codex resume --last"
default  tools.codex.rules[0].pattern = "(?m)^\\s*›\\s+\\d+\\."
default  tools.codex.rules[0].state = "waiting"
default  tools.codex.rules[1].pattern = "(?m)Press enter to (confirm|continue)\\b"
default  tools.codex.rules[1].state = "waiting"
default  tools.codex.rules[2].pattern = "(?m)enter to submit answer\\b"
default  tools.codex.rules[2].state = "waiting"
default  tools.codex.rules[3].pattern = "(?m)^[ \\t]*(?:• )?[^\\n]*\\([\\dhms. ]+ [•·] esc to interrupt\\)(?: · [^\\n]*)?[ \\t]*\\n(?:[ \\t]+└[^\\n]*\\n(?:[ \\t]{4}[^\\n]*\\n)*)?[ \\t\\n]*\\z"
default  tools.codex.rules[3].state = "working"
default  tools.codex.rules[4].pattern = "(?im)^\\s*■.*\\berror\\b"
default  tools.codex.rules[4].state = "errored"
default  tools.codex.scrolled_line = ""
default  tools.codex.session_id_flag = ""
default  tools.codex.session_store = "codex"
default  tools.codex.shell = false
default  tools.codex.skip_rename_directive = false
default  tools.codex.status_source = ""
default  tools.codex.trailing_note = ""
default  tools.codex.turn_end = "(?m)^(?:─+ Worked for [\\dhms. ]+─.*|─{20,}\\s*)$"
default  tools.codex.type_ahead = false
default  tools.opencode.account_command = ""
default  tools.opencode.account_env = ""
default  tools.opencode.account_secret = ""
default  tools.opencode.accounts_command = ""
default  tools.opencode.activity_cutoff = "(?m)^\\s*╹"
default  tools.opencode.arrow_dialog_line = "\\x{21C6} select"
default  tools.opencode.blocked_line = ""
default  tools.opencode.busy_line = ""
default  tools.opencode.chrome_line = "^\\s*(┃.*)?$|^ {40,}\\S.*$"
default  tools.opencode.command = "opencode"
default  tools.opencode.default_status = "idle"
default  tools.opencode.dialog_step_entry = ""
default  tools.opencode.dialog_step_row = ""
default  tools.opencode.echo_budget = "0s"
default  tools.opencode.fork_command = ""
default  tools.opencode.fork_dialog_keys = []
default  tools.opencode.fork_dialog_option = ""
default  tools.opencode.input_line = "^[ \\x{A0}]*┃"
default  tools.opencode.interrupt_keys = []
default  tools.opencode.jump_to_bottom_key = ""
default  tools.opencode.limit_line = "(?i)requires more credits|(?:Usage|Free|Go) limit reached"
default  tools.opencode.mcp = ""
default  tools.opencode.model_flag = ""
default  tools.opencode.models = []
default  tools.opencode.models_command = "opencode models"
default  tools.opencode.prompt_flag = ""
default  tools.opencode.prompt_mode = "send"
default  tools.opencode.rename_command = "/rename"
default  tools.opencode.resume_by_id_command = "opencode --session {id}"
default  tools.opencode.revive_command = "opencode --continue"
default  tools.opencode.rules[0].pattern = "\\x{25B3} Permission required"
default  tools.opencode.rules[0].state = "waiting"
default  tools.opencode.rules[1].pattern = "\\x{21C6} select\\s+enter confirm"
default  tools.opencode.rules[1].state = "waiting"
default  tools.opencode.rules[2].pattern = "(?m)^.*\\benter (?:submit|toggle|confirm)[ \\x{A0}]+esc dismiss[ \\x{A0}]*$"
default  tools.opencode.rules[2].state = "waiting"
default  tools.opencode.rules[3].pattern = "(?i)requires more credits"
default  tools.opencode.rules[3].state = "errored"
default  tools.opencode.rules[4].pattern = "(?im)^\\s*error\\b"
default  tools.opencode.rules[4].state = "errored"
default  tools.opencode.rules[5].pattern = "esc interrupt"
default  tools.opencode.rules[5].state = "working"
default  tools.opencode.scrolled_line = ""
default  tools.opencode.session_id_flag = ""
default  tools.opencode.session_store = "opencode"
default  tools.opencode.shell = false
default  tools.opencode.skip_rename_directive = true
default  tools.opencode.status_source = ""
default  tools.opencode.trailing_note = ""
default  tools.opencode.turn_end = "^ *[^ ┃].*· \\d+(?:\\.\\d+)?[hms](?: \\d+[hms])*(?: · [\\d.]+ tok/s)?(?: {2,}.*)?$"
default  tools.opencode.type_ahead = false
