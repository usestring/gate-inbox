# Every setting the board resolves, one per line, marked with where its value came from:
#   file     written in config.toml and used as written
#   file*    written in config.toml, but the board uses a different value (the file's follows)
#   default  not in config.toml; filled from the built-in default
#   ignored  written in config.toml, but no setting reads it
file     adopt_sockets = ["scratch-a", "scratch-b"]
default  board.sidebar = "right"
file*    children.auto_archive_after = "1h0m0s"
         (file: "1h")
default  children.finished_grace = "10m0s"
default  children.keep_finished = false
file     editor = "vi"
file     extensions.artifacts.base_url = "https://artifacts.example.test"
file     extensions.artifacts.enabled = true
file     extensions.artifacts.identity_command = "printf ada@example.test"
file     extensions.artifacts.key_command = "printf fake-signing-key"
file     extensions.artifacts.key_secret = "EXAMPLE_ARTIFACT_KEY"
file     extensions.artifacts.link_ttl = "24h"
file     extensions.artifacts.max_bytes = 1024
