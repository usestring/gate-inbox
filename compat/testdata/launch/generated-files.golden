            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || { [ -z \"$GATE_INBOX_BIN\" ] || [ -z \"$GATE_INBOX_SESSION_ID\" ] || \"$GATE_INBOX_BIN\" hook ask-pending 2\u003e/dev/null; }; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || rm -f \"$f\" \"$f.attest\" \"$f.sandbox-stale\"; git rev-parse --git-dir \u003e/dev/null 2\u003e\u00261 \u0026\u0026 { git worktree prune \u003e/dev/null 2\u003e\u00261; git submodule --quiet foreach --recursive 'git worktree prune \u003e/dev/null 2\u003e\u00261 || true' \u003e/dev/null 2\u003e\u00261; }; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf 'idle SessionStart\\n' \u003e\u003e \"$f\""
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || { [ -z \"$GATE_INBOX_BIN\" ] || [ -z \"$GATE_INBOX_SESSION_ID\" ] || \"$GATE_INBOX_BIN\" hook session-start 2\u003e/dev/null; }; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf 'finished Stop\\n' \u003e\u003e \"$f\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
