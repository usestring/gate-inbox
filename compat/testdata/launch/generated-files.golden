=== hooks/claude-settings.json
{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf waiting \u003e \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf working \u003e \"$f\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || { if grep -q '\"tool_name\"[[:space:]]*:[[:space:]]*\"AskUserQuestion\"'; then printf waiting; else printf working; fi \u003e \"$f\"; }"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || rm -f \"$f\"; git rev-parse --git-dir \u003e/dev/null 2\u003e\u00261 \u0026\u0026 { git worktree prune \u003e/dev/null 2\u003e\u00261; git submodule --quiet foreach --recursive 'git worktree prune \u003e/dev/null 2\u003e\u00261 || true' \u003e/dev/null 2\u003e\u00261; }; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf idle \u003e \"$f\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf finished \u003e \"$f\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf errored \u003e \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$GATE_INBOX_STATUS_FILE\"; [ -z \"$f\" ] || printf working \u003e \"$f\""
          }
        ]
      }
    ]
  }
}
