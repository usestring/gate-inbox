plan.command: claude 'Fix the flaky widget test and report what changed.' --session-id <uuid>
plan.launch_prompt: "Fix the flaky widget test and report what changed."
plan.agent_session_id: "<uuid>"
plan.model: ""
plan.account: ""
launch.command: claude 'Fix the flaky widget test and report what changed.' --session-id <uuid> --mcp-config '<scratch>/gihome/hooks/gate-inbox-mcp-claude-<stamp>.json' --append-system-prompt-file '<scratch>/gihome/hooks/gate-inbox-claude-delegation-<stamp>.md' --settings '<scratch>/gihome/hooks/claude-settings-<stamp>.json'
launch.env.EXAMPLE_API_KEY=<redacted>
launch.env.GATE_INBOX_BIN=<scratch>/gihome/bin/gate-inbox
launch.env.GATE_INBOX_EXIT_FILE=<scratch>/gihome/hooks/cafe0001.exit
launch.env.GATE_INBOX_HOME=<scratch>/gihome
launch.env.GATE_INBOX_SESSION_ID=cafe0001
launch.env.GATE_INBOX_STATUS_FILE=<scratch>/gihome/hooks/cafe0001.status
launch.env.HOME=<scratch>/user
launch.env.OPERATOR_EXPORT=inherited
launch.env.PATH=<scratch>/bin
launch.env.TMUX_TMPDIR=<scratch>/tmux

