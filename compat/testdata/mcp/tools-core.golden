    "additionalProperties": false,
    "properties": {
      "body": {
        "description": "the comment as the author will read it",
        "type": "string"
      },
      "context": {
        "description": "for the operator only: why it matters, and what the pull request's description claims that this checks",
        "type": "string"
      },
      "kind": {
        "description": "finding (default) for a problem, question for something the operator should ask the author",
        "type": "string"
      },
      "line": {
        "description": "the line the comment is on: the new file's line on RIGHT, the old file's on LEFT; it must be part of the diff",
        "type": "integer"
      },
      "number": {
        "description": "the pull request's number",
        "type": "integer"
      },
      "path": {
        "description": "the file the comment is on, as the diff names it",
        "type": "string"
      },
      "repo": {
        "description": "the pull request's repository as owner/name",
        "type": "string"
      },
      "side": {
        "description": "RIGHT (default) for an added or unchanged line, LEFT for a removed one",
        "type": "string"
      }
    },
    "required": [
      "repo",
      "number",
      "path",
      "line",
      "body"
    ],
    "type": "object"
  },
  "name": "review_comment"
}

