=== read_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Read what another agent is doing: call it after create_session to confirm the agent started on the task, and again to check progress, read an answer, or see why a session is waiting. Every read returns a digest -- the session's status, the question it is holding if any, and the last thing it said -- so check whether a child finished there rather than by reading its prose for a verdict. When it is on a question dialog, digest.questions lists every question in it -- index, header, full text, options with their descriptions, and which are already answered -- including the ones a several-question dialog is not showing, read without touching its pane. With no since, output is the plain text visible in that session's pane, which is the current screen rather than its full history, and a stopped session returns the last screen Gate Inbox captured. Pass the cursor a previous read returned as since and output is only what the session has added since then, which is what a repeat read should use: the whole pane again is the same few thousand characters whether the agent worked for a minute or an hour. A session whose transcript cannot be read returns its pane anyway, with degraded saying why.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "session_id": {
        "description": "session id returned by list_sessions or create_session",
        "type": "string"
      },
      "since": {
        "description": "cursor from a previous read of this session; returns only what it has added since, instead of the whole pane",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "read_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "description": "pass back as since on the next read to get only what the session added after this point",
        "type": "string"
      },
      "degraded": {
        "description": "why a requested delta fell back to the whole pane",
        "type": "string"
      },
      "digest": {
        "additionalProperties": false,
        "description": "the session's status, the question it is holding, and its last result",
        "properties": {
          "question": {
            "description": "question the session is waiting on, with its options; empty when nothing is being asked",
            "type": "string"
          },
          "questions": {
            "description": "every question of the dialog the session is holding, with its header, full text, options and whether it is answered; answer them with answer_session",
            "items": {
              "additionalProperties": false,
              "properties": {
                "answer": {
                  "description": "the answer it has, when the pane shows it",
                  "type": "string"
                },
                "answered": {
                  "description": "whether this question already has an answer in the dialog",
                  "type": "boolean"
                },
                "header": {
                  "description": "the question's short header, drawn as its tab label; answer_session's answers accept it as question",
                  "type": "string"
                },
                "id": {
                  "description": "the question's id in the child's own record, when its CLI gives one",
                  "type": "string"
                },
                "index": {
                  "description": "1-based position in the dialog; answer_session's answers accept it as question",
                  "type": "integer"
                },
                "multi_select": {
                  "description": "true for a question answered by ticking several boxes; answer it with ticks, the labels to leave ticked",
                  "type": "boolean"
                },
                "on_screen": {
                  "description": "the question the dialog is showing now",
                  "type": "boolean"
                },
                "options": {
                  "description": "the child's own choices in order, without the dialog's Type something and Chat about this rows",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "checked": {
                        "description": "on a multi-select question on the screen, whether its box is ticked",
                        "type": "boolean"
                      },
                      "description": {
                        "description": "what the child said the choice means",
                        "type": "string"
                      },
                      "label": {
                        "description": "the choice's text; pass it as the answer to pick it",
                        "type": "string"
                      },
                      "preview": {
                        "description": "the markdown the dialog shows beside this option when it is focused, read whole from the child's call",
                        "type": "string"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "type": "object"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "question": {
                  "description": "the full question; empty only for a question not on the screen when no transcript could be read",
                  "type": "string"
                }
              },
              "required": [
                "index",
                "question",
                "answered"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "result": {
            "description": "the session's most recent prose turn, which is the closest thing to its result",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "mode": {
        "description": "pane when output is the whole visible screen, delta when it is only what was added after the since cursor",
        "type": "string"
      },
      "output": {
        "description": "the session's output: its whole visible pane, or, when since was passed, only the conversation added after that cursor",
        "type": "string"
      },
      "session": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "description": "named subscription the session runs on; empty is the CLI's own login",
            "type": "string"
          },
          "archived": {
            "description": "whether the session is archived out of the active list",
            "type": "boolean"
          },
          "detached": {
            "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
            "type": "boolean"
          },
          "directory": {
            "description": "session's current working directory, or its launch directory when stopped",
            "type": "string"
          },
          "group": {
            "description": "group path holding the session; empty is the root",
            "type": "string"
          },
          "id": {
            "description": "agent session id",
            "type": "string"
          },
          "model": {
            "description": "model that CLI runs on; empty is the CLI's own default",
            "type": "string"
          },
          "name": {
            "description": "session name shown in Gate Inbox",
            "type": "string"
          },
          "parent_id": {
            "description": "session this row is drawn under on the board; empty for a top-level session",
            "type": "string"
          },
          "permissions": {
            "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "running": {
            "description": "whether the session currently has a live tmux pane",
            "type": "boolean"
          },
          "self": {
            "description": "whether this row is the calling session itself",
            "type": "boolean"
          },
          "spawned_by": {
            "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
            "type": "string"
          },
          "tool": {
            "description": "agent CLI the session runs",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tool",
          "group",
          "directory",
          "status",
          "running",
          "archived",
          "self"
        ],
        "type": "object"
      }
    },
    "required": [
      "session",
      "output",
      "mode",
      "digest"
    ],
    "type": "object"
  }
}

