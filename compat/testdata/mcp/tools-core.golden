=== read_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Read what another agent is doing: call it after create_session to confirm the agent started on the task, and again to check progress, read an answer, or see why a session is waiting. Every read returns a digest -- the session's status, the question it is holding if any, and the last thing it said -- so check whether a child finished there rather than by reading its prose for a verdict. With no since, output is the plain text visible in that session's pane, which is the current screen rather than its full history, and a stopped session returns the last screen Gate Inbox captured. Pass the cursor a previous read returned as since and output is only what the session has added since then, which is what a repeat read should use: the whole pane again is the same few thousand characters whether the agent worked for a minute or an hour. A session whose transcript cannot be read returns its pane anyway, with degraded saying why.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "session_id": {
        "description": "session id returned by list_sessions or create_session",
        "type": "string"
      },
      "since": {
        "description": "cursor from a previous read of this session; returns only what it has added since, instead of the whole pane",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "read_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "cursor": {
        "description": "pass back as since on the next read to get only what the session added after this point",
        "type": "string"
      },
      "degraded": {
        "description": "why a requested delta fell back to the whole pane",
        "type": "string"
      },
      "digest": {
        "additionalProperties": false,
        "description": "the session's status, the question it is holding, and its last result",
        "properties": {
          "question": {
            "description": "question the session is waiting on, with its options; empty when nothing is being asked",
            "type": "string"
          },
          "result": {
            "description": "the session's most recent prose turn, which is the closest thing to its result",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "mode": {
        "description": "pane when output is the whole visible screen, delta when it is only what was added after the since cursor",
        "type": "string"
      },
      "output": {
        "description": "the session's output: its whole visible pane, or, when since was passed, only the conversation added after that cursor",
        "type": "string"
      },
      "session": {
        "additionalProperties": false,
        "properties": {
          "account": {
            "description": "named subscription the session runs on; empty is the CLI's own login",
            "type": "string"
          },
          "archived": {
            "description": "whether the session is archived out of the active list",
            "type": "boolean"
          },
          "directory": {
            "description": "session's current working directory, or its launch directory when stopped",
            "type": "string"
          },
          "group": {
            "description": "group path holding the session; empty is the root",
            "type": "string"
          },
          "id": {
            "description": "agent session id",
            "type": "string"
          },
          "model": {
            "description": "model that CLI runs on; empty is the CLI's own default",
            "type": "string"
          },
          "name": {
            "description": "session name shown in Gate Inbox",
            "type": "string"
          },
          "parent_id": {
            "description": "session this row is drawn under on the board; empty for a top-level session",
            "type": "string"
          },
          "running": {
            "description": "whether the session currently has a live tmux pane",
            "type": "boolean"
          },
          "self": {
            "description": "whether this row is the calling session itself",
            "type": "boolean"
          },
          "spawned_by": {
            "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children; empty for a session nobody spawned",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
            "type": "string"
          },
          "tool": {
            "description": "agent CLI the session runs",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tool",
          "group",
          "directory",
          "status",
          "running",
          "archived",
          "self"
        ],
        "type": "object"
      }
    },
    "required": [
      "session",
      "output",
      "mode",
      "digest"
    ],
    "type": "object"
  }
}

