=== message_status
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Check what happened to a message send_session queued, before you build on the handoff: queued, held, delivered, superseded, dropped or answered. Works for your own messages and any message sent to a session you spawned. Held: nothing will type it in as things stand (a dialog on screen, or the session archived or not running); reason says which. Superseded: a later message on the same subject replaced it. Dropped: it will not be retried, so send it again.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "message_id": {
        "description": "message id returned by send_session",
        "type": "integer"
      }
    },
    "required": [
      "message_id"
    ],
    "type": "object"
  },
  "name": "message_status",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "type": "string"
      },
      "delivered_at": {
        "description": "RFC3339 time the message reached the prompt",
        "type": "string"
      },
      "interrupt": {
        "description": "sent with interrupt: the recipient's running turn is stopped before it is typed in, unless a dialog is showing",
        "type": "boolean"
      },
      "message_id": {
        "type": "integer"
      },
      "reason": {
        "description": "why the message is in that state, and what to do about it",
        "type": "string"
      },
      "session_id": {
        "description": "session the message was addressed to",
        "type": "string"
      },
      "state": {
        "description": "queued (waiting for the agent to be at rest), superseded (a later message from you on the same subject replaced it), held (nothing will type it in as things stand: the recipient is sitting on a dialog, has a person typing or a draft at its prompt, is archived or not running, and reason says which), delivered (typed into its prompt), dropped (it never reached the prompt and is not retried; reason starts 'recipient ended' when the session it was sent to ended first), or answered (it has since messaged back)",
        "type": "string"
      }
    },
    "required": [
      "message_id",
      "session_id",
      "body",
      "state"
    ],
    "type": "object"
  }
}

