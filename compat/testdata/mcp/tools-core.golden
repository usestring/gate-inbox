=== answer_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Answer the dialog a session you spawned has stopped on: a question, multi-select, permission prompt, trust dialog or any other screen. Only the session that spawned a child may answer it. send_session cannot: a message waits until the child is at rest, and a child on a dialog never is. Answer yourself only what your brief to that child or your user's standing decisions settle. Otherwise ask your user with your own question tool, copying the header, the question, every option and any recommendation word for word, and pass what they chose. Permission prompts, trust dialogs (Codex's directory-trust prompt too) and questions headed Approval are always your user's call, never yours: relay them word for word, then pass answer set to the text of the choice they picked (never its position) and relay: true. relay: true checks your transcript for that dialog and your user's answer, and refuses a paraphrase, an answer given before the child stopped, or one already relayed; the refusal says exactly what to ask. Give one of answer (the option's text, or your own words for its free-text row), answers (one entry per question), ticks (a multi-select: the labels to leave ticked) or keys (a screen it cannot read as choices: quote it to your user, offer the keys as options, relay: true only). It submits once every question has an answer (submit false stops before that), reads back what the child registered, and errors if that differs from what you gave. The \"Chat about this\" row is refused. Codex: free text goes in its None of the above note, and an unanswered question expires after about two minutes. OpenCode: separate multi-select picks with commas.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "answer": {
        "description": "one answer for the dialog on screen: the option's text, or your own words to type. Give one of answer, answers, ticks or keys",
        "type": "string"
      },
      "answers": {
        "description": "one entry per question, naming it by 1-based index, header or text (as read_session's digest.questions lists them) with the option text or your own words; questions left out stay open",
        "items": {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "description": "the option's text to pick it, or your own words to type into that question's free-text row; give this or ticks",
              "type": "string"
            },
            "question": {
              "description": "which question: its 1-based index, header or text, as digest.questions lists them; empty for the one on screen",
              "type": "string"
            },
            "ticks": {
              "description": "for a multi-select question only: the labels of every option to leave ticked; the rest are unticked",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            }
          },
          "required": [
            "question"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "keys": {
        "description": "for a screen with no readable choices: the keys your user chose, such as [\"Down\", \"Enter\"] (Up, Down, Left, Right, Enter, Tab, BTab, Escape, Space, BSpace, or one letter or digit). Requires relay: true",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "relay": {
        "description": "true when every answer is your user's own choice, asked word for word with your own question tool after the child stopped. Required for questions headed Approval, permission prompts, trust dialogs and keys",
        "type": "boolean"
      },
      "session_id": {
        "description": "child session holding the dialog, as list_sessions or the relayed message names it",
        "type": "string"
      },
      "submit": {
        "description": "with answers: press Submit once every question is answered (default true); false leaves the review page",
        "type": [
          "null",
          "boolean"
        ]
      },
      "ticks": {
        "description": "for a multi-select on screen: the labels of every option to leave ticked; the rest are unticked",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "answer_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "answer": {
        "description": "what was sent back",
        "type": "string"
      },
      "answers": {
        "description": "each question this call answered, in order",
        "items": {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "description": "the answer given",
              "type": "string"
            },
            "header": {
              "description": "that question's header",
              "type": "string"
            },
            "index": {
              "description": "1-based question answered",
              "type": "integer"
            },
            "selected": {
              "description": "option it picked; empty when the answer was typed",
              "type": "string"
            }
          },
          "required": [
            "index",
            "answer"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "name": {
        "description": "that session's name",
        "type": "string"
      },
      "question": {
        "description": "the question as its pane showed it",
        "type": "string"
      },
      "questions": {
        "description": "every question of the dialog after this call, with which are answered",
        "items": {
          "additionalProperties": false,
          "properties": {
            "answer": {
              "description": "the answer it has, when the pane shows it",
              "type": "string"
            },
            "answered": {
              "description": "whether this question already has an answer in the dialog",
              "type": "boolean"
            },
            "header": {
              "description": "the question's short header, drawn as its tab label; answer_session's answers accept it as question",
              "type": "string"
            },
            "id": {
              "description": "the question's id in the child's own record, when its CLI gives one",
              "type": "string"
            },
            "index": {
              "description": "1-based position in the dialog; answer_session's answers accept it as question",
              "type": "integer"
            },
            "multi_select": {
              "description": "true for a question answered by ticking several boxes; answer it with ticks, the labels to leave ticked",
              "type": "boolean"
            },
            "on_screen": {
              "description": "the question the dialog is showing now",
              "type": "boolean"
            },
            "options": {
              "description": "the child's own choices in order, without the dialog's Type something and Chat about this rows",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "checked": {
                    "description": "on a multi-select question on the screen, whether its box is ticked",
                    "type": "boolean"
                  },
                  "description": {
                    "description": "what the child said the choice means",
                    "type": "string"
                  },
                  "label": {
                    "description": "the choice's text; pass it as the answer to pick it",
                    "type": "string"
                  },
                  "preview": {
                    "description": "the markdown the dialog shows beside this option when it is focused, read whole from the child's call",
                    "type": "string"
                  }
                },
                "required": [
                  "label"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "question": {
              "description": "the full question; empty only for a question not on the screen when no transcript could be read",
              "type": "string"
            }
          },
          "required": [
            "index",
            "question",
            "answered"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "screen_changed": {
        "description": "for keys: true when the child's screen was seen to change after the keys were sent",
        "type": "boolean"
      },
      "selected": {
        "description": "option the answer picked; empty when the answer was typed instead",
        "type": "string"
      },
      "session_id": {
        "description": "child session that was holding the question",
        "type": "string"
      },
      "standing_questions": {
        "description": "questions still unanswered in the same dialog after this one",
        "type": "integer"
      },
      "submitted": {
        "description": "true when the dialog was submitted and the child has its answers; false with standing_questions above zero means it is still waiting on the rest",
        "type": "boolean"
      },
      "verified": {
        "description": "true when what the child registered was read back after answering (its screen, or its CLI's own record of the call) and is exactly the answers given; false when the answers were keyed but the child has not registered them yet, such as a dialog still waiting on other questions",
        "type": "boolean"
      }
    },
    "required": [
      "session_id",
      "name",
      "question",
      "answer",
      "verified"
    ],
    "type": "object"
  }
}

=== archive_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "File a finished session out of the active list, or restore one with archived false. Archiving ENDS a running agent and every session it spawned (revive_session brings one back), so read_session first if you are not sure it has finished. Tasks they held go back to pending. Finished children archive on their own after a grace period.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "true (default) archives the session; false restores it",
        "type": [
          "null",
          "boolean"
        ]
      },
      "session_id": {
        "description": "session id returned by list_sessions",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "archive_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "children_skip_permissions": {
        "description": "sessions it spawns run with their permission prompts off unless the spawn says otherwise",
        "type": "boolean"
      },
      "detached": {
        "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "muted": {
        "description": "whether the operator has muted this session out of their triage queue until it is unmuted",
        "type": "boolean"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "permissions": {
        "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "released_tasks": {
        "description": "how many tasks this archive or kill handed back to pending: claims this session (and, on an archive, everything filed with it) held in progress, which any agent can now claim",
        "type": "integer"
      },
      "running": {
        "description": "whether the session currently has a live tmux pane",
        "type": "boolean"
      },
      "self": {
        "description": "whether this row is the calling session itself",
        "type": "boolean"
      },
      "skip_permissions": {
        "description": "the session runs with its CLI's permission prompts off",
        "type": "boolean"
      },
      "spawned_by": {
        "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
        "type": "string"
      },
      "status": {
        "description": "Gate Inbox status: starting, working, waiting, delegating, background, finished, idle, errored or dead",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the session runs",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "tool",
      "group",
      "directory",
      "status",
      "running",
      "archived",
      "muted",
      "self"
    ],
    "type": "object"
  }
}

=== cleanup_children
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Archive the sessions this one spawned that are done, in one call, instead of archive_session on each. By default it takes children that are finished, idle or dead, each with every session it spawned in turn, and leaves one that is working, waiting on a question, errored, delegating, background, spawned with keep, or still has working children of its own, saying why. Pass statuses to choose the states, all true to archive every child whatever it is doing, and dry_run true to see the plan first. A terminal you opened is taken only once its shell has exited; a running one is left for close_terminal. It reaches only your own fan-out. Archiving ends a running agent: its last screen is kept, the row stays in the archived view for 7 days, and revive_session brings it back. Tasks the archived sessions held in progress go back to pending, counted in released_tasks. You rarely need it for a finished child: Gate Inbox archives one on its own once you have read or been told of its finish and left it alone for the grace period.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "all": {
        "description": "archive every child whatever its state, including ones spawned with keep and ones whose own children are still working",
        "type": "boolean"
      },
      "dry_run": {
        "description": "report what would be archived without archiving anything",
        "type": "boolean"
      },
      "statuses": {
        "description": "states of the children to archive: starting, working, waiting, delegating, background, finished, idle, errored or dead; defaults to finished, idle and dead",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "type": "object"
  },
  "name": "cleanup_children",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "how many children were archived, not counting their own descendants",
        "type": "integer"
      },
      "children": {
        "description": "per-child outcome, in board order",
        "items": {
          "additionalProperties": false,
          "properties": {
            "archived": {
              "description": "whether it was archived (or, on a dry run, would be)",
              "type": "boolean"
            },
            "descendants": {
              "description": "ids of the sessions this child spawned, at any depth, archived with it",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "name": {
              "description": "that session's name",
              "type": "string"
            },
            "released_tasks": {
              "description": "how many tasks this child and its descendants held in progress, handed back to pending by the archive",
              "type": "integer"
            },
            "session_id": {
              "description": "child session id",
              "type": "string"
            },
            "skipped": {
              "description": "why this child was left alone; empty when it was archived",
              "type": "string"
            },
            "status": {
              "description": "the child's state when the cleanup read it",
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "name",
            "status",
            "archived"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "dry_run": {
        "description": "true when nothing was archived and the result is only the plan",
        "type": "boolean"
      },
      "released_tasks": {
        "description": "how many in-progress task claims the archives handed back to pending, across every child and descendant filed; any agent can now claim them",
        "type": "integer"
      },
      "skipped": {
        "description": "how many were left alone, with a reason on each",
        "type": "integer"
      }
    },
    "required": [
      "archived",
      "skipped",
      "children"
    ],
    "type": "object"
  }
}

=== close_terminal
{
