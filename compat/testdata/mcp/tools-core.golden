=== answer_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Answer a question one of your own spawned sessions has stopped on, so the fan-out you started keeps moving instead of waiting on a person who did not set the task. You are told a child has stopped by a message from it; this is how you reply to the dialog itself, which send_session cannot do -- a message is held until the recipient is at rest, and a session on a question never is. Pass the text of the option to pick, or your own words to type instead. It reads Claude Code's AskUserQuestion and Codex's request_user_input, including a dialog asking several questions -- answer that one a question at a time, calling again while standing_questions is above zero. Only the session that spawned it may answer it. A permission prompt, Codex's first-run directory-trust prompt and a multi-select are still a person's to answer, and the refusal says which of them it saw rather than leaving you to guess.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "answer": {
        "description": "the text of the option to pick, or your own words to type into the dialog instead",
        "type": "string"
      },
      "session_id": {
        "description": "child session holding the question, as list_sessions or the relayed message names it",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "answer"
    ],
    "type": "object"
  },
  "name": "answer_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "answer": {
        "description": "what was sent back",
        "type": "string"
      },
      "name": {
        "description": "that session's name",
        "type": "string"
      },
      "question": {
        "description": "the question as its pane showed it",
        "type": "string"
      },
      "selected": {
        "description": "option the answer picked; empty when the answer was typed instead",
        "type": "string"
      },
      "session_id": {
        "description": "child session that was holding the question",
        "type": "string"
      },
      "standing_questions": {
        "description": "questions still unanswered in the same dialog after this one",
        "type": "integer"
      }
    },
    "required": [
      "session_id",
      "name",
      "question",
      "answer"
    ],
    "type": "object"
  }
}

=== archive_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "File a finished session out of the active list, or restore an archived one with archived false. Use it to keep the user's list readable once a session's work is done. This ENDS a running agent: the row and its last screen are kept and revive_session brings it back, but work in progress stops, so read_session first if you are not sure it has finished.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "true archives the session out of the active list, false restores it; defaults to true",
        "type": [
          "null",
          "boolean"
        ]
      },
      "session_id": {
        "description": "session id returned by list_sessions",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "archive_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "running": {
        "description": "whether the session currently has a live tmux pane",
        "type": "boolean"
      },
      "self": {
        "description": "whether this row is the calling session itself",
        "type": "boolean"
      },
      "spawned_by": {
        "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children; empty for a session nobody spawned",
        "type": "string"
      },
      "status": {
        "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the session runs",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "tool",
      "group",
      "directory",
      "status",
      "running",
      "archived",
      "self"
    ],
    "type": "object"
  }
}

=== close_terminal
