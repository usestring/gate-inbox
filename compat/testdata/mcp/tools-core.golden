=== rename
{
  "description": "Rename this session to a short 2-4 word kebab-case name for the broad feature it is about. Call once at the start only when the session still has a placeholder name (e.g. claude-a1b2). If the session already has a real name, leave it unless the user asks to rename. Prefer a broad feature name over a single subtask.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "short 2-4 word kebab-case name for the broad feature of this whole session, not one subtask",
        "type": "string"
      }
    },
