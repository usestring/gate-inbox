  },
  "description": "Call before passing an account to create_session, to find the named accounts a CLI can be launched on instead of guessing one; omit account to follow the board's launch-account setting. An explicit account stays pinned. Each name is a long-lived token in a secret store; a session launched on one spends that account's usage window rather than the operator's own login. Names one CLI's accounts when tool is given, and every configured CLI that can take one when it is omitted; a CLI that cannot says so here rather than at spawn time.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "tool": {
        "description": "agent CLI to ask, such as claude; omit to list every configured CLI that can run on a named account",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "list_accounts"
}

