=== send_children
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Queue one message for every session this one spawned, when the correction is about the work rather than about one worker: the branch moved, the endpoint changed, stop using that field. Sending nine messages by hand means the ninth is written long after the first, and by then the first agents have acted on the old instruction. Use send_session for anything meant for one agent -- this interrupts the whole fan-out, so reach for it only when every child needs to hear it. A child that cannot take the message is reported rather than failing the call, so a full queue on one does not leave the rest uninstructed.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "message": {
        "description": "the instruction every child should get, in full; each reads it with no other context; or name a file in message_file",
        "type": "string"
      },
      "message_file": {
        "description": "absolute path of a file holding the instruction, used instead of message",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "send_children",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "deliveries": {
        "description": "per-child outcome, in board order",
        "items": {
          "additionalProperties": false,
          "properties": {
            "message_id": {
              "description": "queued message id, when it was queued",
              "type": "integer"
            },
            "name": {
              "description": "that session's name",
              "type": "string"
            },
            "session_id": {
              "description": "child session the message was addressed to",
              "type": "string"
            },
            "skipped": {
              "description": "why this child was not sent to; empty when it was queued",
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "name"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "manager_awake": {
        "description": "whether Gate Inbox is running to deliver what was queued",
        "type": "boolean"
      },
      "queued": {
        "description": "how many children the message was queued for",
        "type": "integer"
      },
      "skipped": {
        "description": "how many were passed over, with a reason on each",
        "type": "integer"
      }
    },
    "required": [
      "queued",
      "skipped",
      "manager_awake",
      "deliveries"
    ],
    "type": "object"
  }
}

=== send_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Queue a message for another agent, to give a session you spawned its next task, answer a question read_session surfaced, or redirect work going the wrong way. The other agent has no view of this conversation, so send a self-contained instruction. The message is not typed in the instant you send it: Gate Inbox holds it until that agent can read it -- at rest, or for Claude Code mid-turn, where it is queued and read after the running tool call -- so it can never land on an approval prompt and answer it. A successful send means queued, not delivered: do not tell anyone the agent has it until message_status says delivered. Two modes. By default (interrupt false) the agent finishes the tool call in hand and then reads the message. With interrupt true, Gate Inbox first stops the agent's running turn (Escape for Claude Code) and types the message in as its next turn: use it when the work in progress is wrong and every further step is waste. Interrupt is refused for a CLI with no safe way to stop a turn, and neither mode ever sends keys while a permission or question dialog is showing: the message is held and the result says so. It arrives labelled as coming from another agent rather than from the user, and cannot approve permissions or change that agent's configuration. Returns a message id for message_status, and says so straight away when nothing will type the message in as things stand -- an agent sitting on a dialog is the usual reason, and answer_session is what clears that. Pass subject to label what the message is about: your next message on the same subject replaces this one if it has not been read yet, so a correction reaches the agent instead of queueing behind what it corrects. Call read_session to see what the agent did with it. Refused rather than delivered: identical text to the same session inside ten minutes, more than five messages a minute per recipient, more than twenty undelivered held by a recipient, or a message over 8000 bytes (point the agent at a file or a task instead). A message already written to disk is sent by naming it in message_file instead of pasting it into message. After a refusal, call message_status on the earlier message rather than sending again.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "interrupt": {
        "description": "true stops the agent's running turn first (Escape for Claude Code) so this message is its next turn right away; false, the default, lets it finish the step in hand and read the message after. Refused for a CLI with no safe interrupt; never sent while a dialog is showing",
        "type": "boolean"
      },
      "message": {
        "description": "message typed into that agent's prompt as its next turn; write it as a full instruction, since the other agent does not see this conversation; or name a file in message_file",
        "type": "string"
      },
      "message_file": {
        "description": "absolute path of a file holding the message, used instead of message; the same size limit applies to what it holds",
        "type": "string"
      },
      "session_id": {
        "description": "session id returned by list_sessions or create_session",
        "type": "string"
      },
      "subject": {
        "description": "short label for what this message is about, such as which-branch or stand-down; a later message you send to the same agent under the same label replaces this one if it has not been read yet, so a correction arrives instead of queueing behind what it corrects",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "send_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "handled": {
        "description": "what the build's extensions made of an operator's send, each under its extension's id; the message is queued and delivered either way",
        "items": {
          "additionalProperties": false,
          "properties": {
            "extension": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "required": [
            "extension",
            "result"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "held": {
        "description": "why nothing will type this message into the recipient as things stand, and what to do about it; empty means it is simply waiting for the agent to be at rest",
        "type": "string"
      },
      "interrupt": {
        "description": "whether the recipient's running turn is stopped before the message is typed in",
        "type": "boolean"
      },
      "manager_awake": {
        "description": "whether Gate Inbox is running to deliver it; a message queued while it is closed waits until it opens again",
        "type": "boolean"
      },
      "message_id": {
        "description": "pass to message_status to see whether it arrived",
        "type": "integer"
      },
      "queue_position": {
        "description": "this message's place in the recipient's queue; 1 means it is next",
        "type": "integer"
      },
      "relayed": {
        "description": "whether this was relayed as the operator's words; with no message_id, nothing was queued and there is nothing to track",
        "type": "boolean"
      },
      "superseded": {
        "description": "how many earlier queued messages from this sender on the same subject this one replaced",
        "type": "integer"
      }
    },
    "required": [
      "message_id",
      "queue_position",
      "manager_awake"
    ],
    "type": "object"
  }
}

