        "description": "terminal id returned by list_terminals or create_terminal",
        "type": "string"
      }
    },
    "required": [
      "terminal_id"
    ],
    "type": "object"
  },
  "name": "close_terminal"
}

=== create_group
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Add a heading to the user's list, for work the user asked to file separately, such as another repository or a parked track. Not for a fan-out: every session this one creates is its child and already sits together under it, and a nested session cannot be filed in another group. Call list_groups first so an existing heading is reused. Nest with a slash path such as work/payments, whose parent must already exist.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "default working directory sessions created in this group inherit",
        "type": "string"
      },
      "path": {
        "description": "full group path, slash separated for nesting (e.g. work/payments); every parent except the last segment must already exist",
        "type": "string"
      },
      "pin": {
        "description": "true to start every session spawned into this group in directory, whatever directory it asks for, so that repository's settings and MCP servers load; needs directory",
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "name": "create_group",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "whether the group is archived",
        "type": "boolean"
      },
      "directory": {
        "description": "group's default working directory, inherited by sessions created in it",
        "type": "string"
      },
      "path": {
        "description": "full group path, slash separated; pass this value as a group argument",
        "type": "string"
      },
      "pinned": {
        "description": "whether every session spawned into this group starts in its directory, whatever directory it was asked for",
        "type": "boolean"
      },
      "sessions": {
        "description": "number of active agent sessions directly in this group",
        "type": "integer"
      }
    },
    "required": [
      "path",
      "archived",
      "sessions"
    ],
    "type": "object"
  }
}

=== create_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Start another agent CLI in its own Gate Inbox session and hand it a task. For new delegated work, use it instead of your CLI's built-in subagent tool (Agent/Task, spawn_agent, opencode's subagent); keep that for a quick read-only lookup. Call list_sessions first, and send_session instead when a session already owns the work. The new agent cannot see this conversation, so the prompt is the whole brief: the goal and why, what is already known or ruled out, the files or docs to read (paths, not pasted text), the scope and its limits, the approvals it already has, and what to report back. Put a long brief in prompt_file. For repo work beside other agents, pass a directory that is its own checkout. The new session is your child: its questions, rests and finishes are relayed here. Leave nest alone for a fan-out and never create a group for one; nest false is a detach, for a standalone session the user owns. Follow it with read_session or wait_for_session.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named account from list_accounts; omit to follow the board's launch-account setting; a child does not inherit its parent's account",
        "type": "string"
      },
      "directory": {
        "description": "existing directory to work in; defaults to this agent's, or to the group's path when group is set; a group that pins its directory starts the session there instead, unless directory_reason is given",
        "type": "string"
      },
      "directory_reason": {
        "description": "why the session must start in directory although its group pins another; leave empty unless the task only works when started there",
        "type": "string"
      },
      "group": {
        "description": "existing group path for a detached session (nest false); empty string for the root group; a nested session refuses any group but this agent's",
        "type": [
          "null",
          "string"
        ]
      },
      "keep": {
        "description": "keep this child listed after it finishes; otherwise a finished child is archived once you have seen its finish and left it for the grace period (10 minutes by default)",
        "type": "boolean"
      },
      "model": {
        "description": "a model name the CLI accepts (claude: sonnet, opus, haiku, opus[1m], sonnet[1m]; opencode: provider/model); an unknown name kills the session at launch, so take names from list_models rather than guessing; omit for the CLI's default",
        "type": "string"
      },
      "name": {
        "description": "kebab-case name of 2-4 words for the work (e.g. payments-retry-fix); leave empty only when the task is unknown",
        "type": "string"
      },
      "nest": {
        "description": "omit it: the new session is your child, and its questions, rests and finishes are relayed to you. false detaches it into a top-level session the user owns: nothing is relayed, you cannot answer its dialogs, and you reach it only with send_session and read_session. Only for work that is not yours, such as a standalone session the user asked for",
        "type": [
          "null",
          "boolean"
        ]
      },
      "prompt": {
        "description": "the whole brief, as a full instruction; empty starts the session idle; a long brief goes in prompt_file",
        "type": "string"
      },
      "prompt_file": {
        "description": "absolute path of a file holding the brief, used instead of prompt",
        "type": "string"
      },
      "skip_permissions": {
        "description": "omit to follow the user's setting for this session's children; true launches it with its CLI's permission prompts off and is refused unless the user allowed that for your children; false keeps them on",
        "type": [
          "null",
          "boolean"
        ]
      },
      "tasks": {
        "description": "tasks to assign to the new session before it starts: existing pending tasks by id, or new ones by title (with body and depends_on); only it may claim them, and its prompt lists them",
        "items": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "description": "the new task's full instruction",
              "type": "string"
            },
            "depends_on": {
              "description": "ids of tasks the new task waits on",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "id": {
              "description": "an existing pending task to assign to the new session; you must be its creator or assignee; omit to create a new task instead",
              "type": "string"
            },
            "title": {
              "description": "a new task to create and assign to the new session: one-line summary of the work",
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "tool": {
        "description": "agent CLI to run, such as claude, codex or opencode; defaults to this session's CLI, and is required when this session is a terminal",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "create_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "children_skip_permissions": {
        "description": "sessions it spawns run with their permission prompts off unless the spawn says otherwise",
        "type": "boolean"
      },
      "detached": {
        "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "muted": {
        "description": "whether the operator has muted this session out of their triage queue until it is unmuted",
        "type": "boolean"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "permissions": {
        "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "released_tasks": {
        "description": "how many tasks this archive or kill handed back to pending: claims this session (and, on an archive, everything filed with it) held in progress, which any agent can now claim",
        "type": "integer"
      },
