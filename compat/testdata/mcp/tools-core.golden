=== list_sessions
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Call first whenever the work involves another agent: before delegating, before reporting what the fleet is doing, and to find a session's id. Lists every agent session Gate Inbox knows (separate CLI processes, not your subagents) with ids, names, CLIs, groups, directories, statuses (starting, working, waiting, finished, idle, errored, dead) and which row is this session. Reuse a relevant idle session instead of creating another; otherwise call create_session. Filter rather than reading the whole board, which can run to hundreds of kilobytes: parent \"me\" is your own children, status narrows by state, and archived rows are left out unless you ask for them.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "include_archived": {
        "description": "also list sessions archived out of the active list, which on a long-lived board are most of the table; pass it only when looking for a row to restore with archive_session",
        "type": "boolean"
      },
      "include_text": {
        "description": "when false, the readable rendering is replaced by a one-line count and the rows come back only in the structured result, which halves the reply; omit or true for both renderings",
        "type": [
          "null",
          "boolean"
        ]
      },
      "limit": {
        "description": "how many rows to return (default 50, maximum 500); the reply says how many matched, so a truncated one is never silent",
        "type": "integer"
      },
      "parent": {
        "description": "keep only the sessions this one spawned; pass \"me\" for this session's own children, which is the fan-out it is steering; omit for every session whoever spawned it",
        "type": "string"
      },
      "status": {
        "description": "keep only sessions in these states: starting, working, waiting, finished, idle, errored or dead; omit for every state",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "type": "object"
  },
  "name": "list_sessions",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "matched": {
        "description": "how many sessions matched the filters, before limit",
        "type": "integer"
      },
      "returned": {
        "description": "how many rows are in sessions",
        "type": "integer"
      },
      "sessions": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "account": {
              "description": "named subscription the session runs on; empty is the CLI's own login",
              "type": "string"
            },
            "archived": {
              "description": "whether the session is archived out of the active list",
              "type": "boolean"
            },
            "detached": {
              "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
              "type": "boolean"
            },
            "directory": {
              "description": "session's current working directory, or its launch directory when stopped",
              "type": "string"
            },
            "group": {
              "description": "group path holding the session; empty is the root",
              "type": "string"
            },
            "id": {
              "description": "agent session id",
              "type": "string"
            },
            "model": {
              "description": "model that CLI runs on; empty is the CLI's own default",
              "type": "string"
            },
            "name": {
              "description": "session name shown in Gate Inbox",
              "type": "string"
            },
            "parent_id": {
              "description": "session this row is drawn under on the board; empty for a top-level session",
              "type": "string"
            },
            "permissions": {
              "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "running": {
              "description": "whether the session currently has a live tmux pane",
              "type": "boolean"
            },
            "self": {
              "description": "whether this row is the calling session itself",
              "type": "boolean"
            },
            "spawned_by": {
              "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
              "type": "string"
            },
            "status": {
              "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
              "type": "string"
            },
            "tool": {
              "description": "agent CLI the session runs",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "tool",
            "group",
            "directory",
            "status",
            "running",
            "archived",
            "self"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "truncated": {
        "description": "true when limit left matching sessions out; narrow parent or status, or raise limit",
        "type": "boolean"
      }
    },
    "required": [
      "sessions",
      "matched",
      "returned",
      "truncated"
    ],
    "type": "object"
  }
}

