        "type": "string"
      }
    },
    "required": [
      "terminal_id"
    ],
    "type": "object"
  },
  "name": "close_terminal"
}

=== create_group
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Add a heading to the user's list, for work the user asked to file separately, such as another repository or a parked track. Not for a fan-out: every session this one creates is its child and already sits together under it, and a nested session cannot be filed in another group. Call list_groups first so an existing heading is reused. Nest with a slash path such as work/payments, whose parent must already exist.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "default working directory sessions created in this group inherit",
        "type": "string"
      },
      "path": {
        "description": "full group path, slash separated for nesting (e.g. work/payments); every parent except the last segment must already exist",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "name": "create_group",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "archived": {
        "description": "whether the group is archived",
        "type": "boolean"
      },
      "directory": {
        "description": "group's default working directory, inherited by sessions created in it",
        "type": "string"
      },
      "path": {
        "description": "full group path, slash separated; pass this value as a group argument",
        "type": "string"
      },
      "sessions": {
        "description": "number of active agent sessions directly in this group",
        "type": "integer"
      }
    },
    "required": [
      "path",
      "archived",
      "sessions"
    ],
    "type": "object"
  }
}

=== create_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Start another agent CLI in its own Gate Inbox session and hand it a task, so independent work runs beside this conversation instead of queued behind it. The new session is a full CLI process of its own on the user's machine, which the user can watch and type into, and it can run a different CLI than this one. Omit account to use the board's subscription routing automatically, including quota-based overflow in smart mode; a child does not inherit a borrowed account from its parent. Call it without waiting for the user when a task splits into parallel parts, or the user asks for a second agent or an independent opinion. Pass a descriptive name and a prompt stating the whole task, since the new agent cannot see this conversation -- a long brief goes in a file named by prompt_file rather than in the call -- and, for repo work beside other agents, a directory that is its own checkout, made with the repository's own tooling first. The new session is this session's child: the user sees the fan-out as a tree under this session, and the child's questions, rests and finishes are relayed here, which is how they get answered. Leave nest alone for a fan-out and never create a group for one; nest false is a detach, for a standalone session that is not this session's work. Follow it with read_session and send_session; use create_terminal instead for a plain shell.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "optional pinned subscription from list_accounts; omit to follow the board's routing settings, using own subscription first and quota-based pool overflow in smart mode; a child does not inherit its parent's borrowed account; an explicit account overrides routing and requires a CLI that accepts a token",
        "type": "string"
      },
      "caller_session_id": {
        "description": "this session's own id from $GATE_INBOX_SESSION_ID in its shell; pass it when that differs from the session this MCP server started as (opencode multiplexes same-cwd conversations through one server)",
        "type": "string"
      },
      "directory": {
        "description": "existing directory the session works in; defaults to this agent's own directory, or to the selected group's inherited path when group is set",
        "type": "string"
      },
      "group": {
        "description": "existing group path for a detached session (nest false) to sit in; pass an empty string for the root group; a nested session is always in this agent's group and refuses any other; call list_groups for the existing ones",
        "type": [
          "null",
          "string"
        ]
      },
      "model": {
        "description": "model that CLI should run on, in whatever names it uses (claude: sonnet, opus, haiku, plus the 1M-context opus[1m] and sonnet[1m]; opencode: provider/model); call list_models for the names a CLI accepts rather than guessing one, since an unknown name is refused by the CLI and the session dies on launch; omit for the CLI's own default",
        "type": "string"
      },
      "name": {
        "description": "kebab-case name for the new session, 2-4 words naming the work it will do (e.g. payments-retry-fix); leave empty only when the task is unknown, and the new agent will name itself",
        "type": "string"
      },
      "nest": {
        "description": "omit it: the new session is this session's child, drawn under it, and its questions, rests and finishes are relayed to this session, which is how a fan-out gets steered; false detaches it into a top-level session that reports to nobody, and is only for work that is not this session's, such as a standalone session the user asked for in another group",
        "type": [
          "null",
          "boolean"
        ]
      },
      "prompt": {
        "description": "first task to hand the new agent, written as a full instruction; it starts idle when empty; a long brief goes in a file named by prompt_file instead",
        "type": "string"
      },
      "prompt_file": {
        "description": "absolute path of a file holding the first task, used instead of prompt when the brief is long; the server reads it, so write the brief once and name it here",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI to run, such as claude, codex or opencode; defaults to the CLI this session runs; call list_sessions to see which are in use",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "create_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "running": {
        "description": "whether the session currently has a live tmux pane",
        "type": "boolean"
      },
      "self": {
        "description": "whether this row is the calling session itself",
        "type": "boolean"
      },
      "spawned_by": {
        "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children; empty for a session nobody spawned",
        "type": "string"
      },
      "status": {
        "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the session runs",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "tool",
      "group",
      "directory",
      "status",
      "running",
      "archived",
      "self"
    ],
    "type": "object"
  }
}

=== create_terminal
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Create a managed terminal for human-visible work such as SSH, not for one-shot local commands or other internal work. It nests under this session unless nest is false, which a group other than this session's needs; a terminal created from a terminal joins it as a sibling under the same agent. The group supplies the inherited directory, and directory set explicitly wins. Then call send_terminal with the returned id; use create_session instead for another agent CLI. Call close_terminal when the job is finished and the terminal is not being left for the user.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "existing directory to open; defaults to the selected group's inherited path, then this agent's current directory",
        "type": "string"
      },
      "group": {
        "description": "existing group path for the new terminal; pass an empty string for the root group; defaults to this agent's group",
        "type": [
          "null",
          "string"
        ]
      },
      "nest": {
        "description": "when true or omitted, nest under this session, or beside it under the same parent when this session is itself a terminal; false places an un-nested terminal in group",
        "type": [
          "null",
          "boolean"
        ]
      }
    },
    "type": "object"
  },
  "name": "create_terminal",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "terminal's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the terminal; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "managed terminal session id",
        "type": "string"
      },
      "name": {
        "description": "terminal name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "id of the parent session when nested; empty when un-nested",
        "type": "string"
      },
      "parent_name": {
        "description": "name of the parent session when nested; empty when un-nested",
        "type": "string"
      },
      "running": {
        "description": "whether the terminal currently has a live tmux pane",
        "type": "boolean"
      },
      "status": {
        "description": "stored Gate Inbox status",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "group",
      "directory",
      "status",
      "running",
      "parent_id",
      "parent_name"
    ],
    "type": "object"
  }
}

=== delete_group
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Delete a group once the work filed under it is done, so a fleet does not leave a heading behind in the user's list. Groups nested under it go too. Any session still filed there moves to the root group rather than being stopped, so this never ends an agent: kill_session or archive_session those first if that is what you mean.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "path": {
        "description": "full group path to delete, slash separated; groups nested under it go too",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "name": "delete_group",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "moved": {
        "description": "ids of sessions that were filed under those groups and now sit in the root group",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "removed": {
        "description": "group paths that no longer exist, the named group and anything nested under it",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "removed"
    ],
    "type": "object"
  }
}

