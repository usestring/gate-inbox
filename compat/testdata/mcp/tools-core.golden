=== send_children
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Queue one message for every session this one spawned, when the correction is about the work rather than about one worker: the branch moved, the endpoint changed, stop using that field. Sending nine messages by hand means the ninth is written long after the first, and by then the first agents have acted on the old instruction. Use send_session for anything meant for one agent -- this interrupts the whole fan-out, so reach for it only when every child needs to hear it. A child that cannot take the message is reported rather than failing the call, so a full queue on one does not leave the rest uninstructed. Pass subject so a later correction on the same subject replaces this one where it is still unread.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "message": {
        "description": "the instruction every child should get, in full; each reads it with no other context; or name a file in message_file",
        "type": "string"
      },
      "message_file": {
        "description": "absolute path of a file holding the instruction, used instead of message",
        "type": "string"
      },
      "subject": {
        "description": "what the message is about, as on send_session: a later send_children or send_session on the same subject replaces it for every child that has not read it yet",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "send_children",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "deliveries": {
        "description": "per-child outcome, in board order",
        "items": {
          "additionalProperties": false,
          "properties": {
            "message_id": {
              "description": "queued message id, when it was queued",
              "type": "integer"
            },
            "name": {
              "description": "that session's name",
              "type": "string"
            },
            "session_id": {
              "description": "child session the message was addressed to",
              "type": "string"
            },
            "skipped": {
              "description": "why this child was not sent to; empty when it was queued",
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "name"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "manager_awake": {
        "description": "whether Gate Inbox is running to deliver what was queued",
        "type": "boolean"
      },
      "queued": {
        "description": "how many children the message was queued for",
        "type": "integer"
      },
      "skipped": {
        "description": "how many were passed over, with a reason on each",
        "type": "integer"
      }
    },
    "required": [
      "queued",
      "skipped",
      "manager_awake",
      "deliveries"
    ],
    "type": "object"
  }
}

=== send_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Queue a message for another agent: a spawned session's next task, an answer to a question it asked, or a correction. It cannot see this conversation, so send a self-contained instruction. A successful send means queued, not delivered: Gate Inbox types it in when the agent can read it (at rest, or for Claude Code after its running tool call), never onto a dialog. Do not tell anyone the agent has it until message_status says delivered. It arrives labelled as from another agent rather than from the user, and cannot approve permissions or change that agent's configuration. A child stopped on a dialog needs answer_session. interrupt true stops the running turn first (Escape for Claude Code) so the message is its next turn: use it when the work in progress is wrong. It is refused for a CLI with no safe interrupt. subject labels the message: your next one on the same subject replaces it while unread. A message already on disk goes in message_file. Refused: identical text to the same session within ten minutes, more than five messages a minute to one recipient, more than twenty undelivered held for one recipient, or over 8000 bytes (point the agent at a file or a task instead). After a refusal, call message_status on the earlier message rather than sending again. Returns a message id; the result says at once when nothing will type the message in, usually because of a dialog. Call read_session to see what the agent did with it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "interrupt": {
        "description": "true stops the agent's running turn first so this message is its next turn; false (default) lets it finish the step in hand. Refused for a CLI with no safe interrupt; never sent while a dialog is showing",
        "type": "boolean"
      },
      "message": {
        "description": "the message, as a full instruction, since the other agent does not see this conversation; or name a file in message_file",
        "type": "string"
      },
      "message_file": {
        "description": "absolute path of a file holding the message, used instead of message; the same size limit applies",
        "type": "string"
      },
      "relay_question": {
        "description": "passes your user's approval to a child you spawned: the question you asked your user with your own question tool, word for word. Gate Inbox checks your transcript for their answer (given after the child was spawned, within 30 minutes, not relayed before) and attaches it as an attestation the child's hook verifies once. Refused while the child shows its own Approval dialog: answer that with answer_session relay: true",
        "type": "string"
      },
      "session_id": {
        "description": "session id returned by list_sessions or create_session",
        "type": "string"
      },
      "subject": {
        "description": "short label such as which-branch or stand-down; a later message to the same agent on the same subject replaces this one while it is unread",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "send_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "attestation": {
        "description": "nonce of the relay attestation attached to this message: your user's answer, verified in your own transcript, which the child's hook spends once",
        "type": "string"
      },
      "handled": {
        "description": "what the build's extensions made of an operator's send, each under its extension's id; the message is queued and delivered either way",
        "items": {
          "additionalProperties": false,
          "properties": {
            "extension": {
              "type": "string"
            },
            "result": {
              "type": "string"
            }
          },
          "required": [
            "extension",
            "result"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "held": {
        "description": "why nothing will type this message into the recipient as things stand, and what to do about it; empty means it is simply waiting for the agent to be at rest",
        "type": "string"
      },
      "interrupt": {
        "description": "whether the recipient's running turn is stopped before the message is typed in",
        "type": "boolean"
      },
      "manager_awake": {
        "description": "whether Gate Inbox is running to deliver it; a message queued while it is closed waits until it opens again",
        "type": "boolean"
      },
      "message_id": {
        "description": "pass to message_status to see whether it arrived",
        "type": "integer"
      },
      "queue_position": {
        "description": "this message's place in the recipient's queue; 1 means it is next",
        "type": "integer"
      },
      "relayed": {
        "description": "whether this was relayed as the operator's words; with no message_id, nothing was queued and there is nothing to track",
        "type": "boolean"
      },
      "restored": {
        "description": "what the send did first to reach your own child: restored it from the archive, revived it on its conversation, or both; empty when it was already running",
        "type": "string"
      },
      "superseded": {
        "description": "how many earlier queued messages from this sender on the same subject this one replaced",
        "type": "integer"
      }
    },
    "required": [
      "message_id",
      "queue_position",
      "manager_awake"
    ],
    "type": "object"
  }
}

=== send_terminal
{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Call after list_terminals or create_terminal to run or control work in a managed terminal, keeping it visible and separate from the conversation. Provide exactly one of command or keys. A command is pasted and submitted with Enter, so it executes on the user's machine. Keys sends exact tmux key names for interactive control, such as [\"C-c\"] or [\"Up\", \"Enter\"]. Call read_terminal after sending to inspect the result.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "command": {
        "description": "command text to paste and submit with Enter; provide exactly one of command or keys",
        "type": "string"
      },
      "keys": {
        "description": "exact tmux key names to send in order, such as C-c, Up, or Enter; provide exactly one of keys or command",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "terminal_id": {
        "description": "terminal id returned by list_terminals or create_terminal",
        "type": "string"
      }
    },
    "required": [
      "terminal_id"
    ],
    "type": "object"
  },
  "name": "send_terminal",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "sent": {
        "description": "input kind sent: command or keys",
        "type": "string"
      },
      "terminal_id": {
        "type": "string"
      }
    },
    "required": [
      "terminal_id",
      "sent"
    ],
    "type": "object"
  }
}

=== set_priority
{
  "description": "Declare how much the work in this session matters, so the user's triage queue hands it over ahead of the sessions that matter less. Call it when you know something the manager cannot see from outside: the user says this is urgent or can wait, or the task turns out to be a production incident, a release blocker, or a background experiment. Tiers are urgent (+3), high (+2), medium (+1), low (-1), lower (-2) and lowest (-3); none or 0 clears it. Numeric levels from -3 to 3 are also accepted. The user's board uses two raised tiers and one lowered by default, and shows a tier past its scale at the scale's edge. It orders this session within the queue it is already in, so it never puts a session that needs nobody ahead of one waiting on an answer, and the user can always override it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "tier": {
        "description": "how much the work in this session matters: urgent (+3), high (+2), medium (+1), none (0), low (-1), lower (-2) or lowest (-3); the board shows tiers past its configured scale at the scale's edge",
        "type": "string"
      }
    },
    "required": [
      "tier"
    ],
    "type": "object"
  },
  "name": "set_priority"
}

=== switch_account
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Move a session onto another named subscription, for when the account it runs on has hit its usage limit or is nearly spent. Claude contexts over 200,000 input tokens (or, for an urgent or high session, over its tier's auto-compact window when that is larger) migrate to a fresh same-tool conversation on the chosen account, returning a new session ID; the new session takes over the source's children and the source is ended and archived. Otherwise a live session restarts on its conversation, and a dead one takes the account at its next revive. This restarts a live agent on the user's machine, so use it on a session that is blocked by a limit or at rest between turns, not one mid-way through work; it cannot be this session itself.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription to move it onto, from list_accounts; empty moves it back to the CLI's own login",
        "type": "string"
      },
      "session_id": {
        "description": "session id returned by list_sessions or create_session; not this session's own, since the restart would end this call",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "switch_account",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "children_skip_permissions": {
        "description": "sessions it spawns run with their permission prompts off unless the spawn says otherwise",
        "type": "boolean"
      },
      "detached": {
        "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "muted": {
        "description": "whether the operator has muted this session out of their triage queue until it is unmuted",
        "type": "boolean"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "permissions": {
        "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "released_tasks": {
        "description": "how many tasks this archive or kill handed back to pending: claims this session (and, on an archive, everything filed with it) held in progress, which any agent can now claim",
        "type": "integer"
      },
      "running": {
        "description": "whether the session currently has a live tmux pane",
        "type": "boolean"
      },
      "self": {
        "description": "whether this row is the calling session itself",
        "type": "boolean"
      },
      "skip_permissions": {
        "description": "the session runs with its CLI's permission prompts off",
        "type": "boolean"
      },
      "spawned_by": {
        "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
        "type": "string"
      },
      "status": {
        "description": "Gate Inbox status: starting, working, waiting, delegating, background, finished, idle, errored or dead",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the session runs",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "tool",
      "group",
      "directory",
      "status",
      "running",
      "archived",
      "muted",
      "self"
    ],
    "type": "object"
  }
}

=== task
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "The shared work list every session on the board claims from; action picks the operation. list: call it before starting work so two agents do not build the same thing. It returns open work (pending and in_progress) as titles, 50 rows by default; the list: arguments narrow or widen it. create: put work up for any session instead of keeping the plan to yourself; split a fleet's plan into tasks and order them with depends_on. claim: take a task before starting it. Without task_id it takes a task assigned to you first, then the oldest unblocked pending task your fleet created (any true widens that to the whole list). A task another session holds is refused. finish: mark it done the moment the work completes, with a note on what came of it; its creator is sent the note, and its dependents become claimable. assign: point a pending task at the one session that may claim it (its creator or assignee may do this); omit assignee to unassign. create_session's tasks argument assigns work to a child as it starts. release: hand a claimed task back. delete: remove work no longer needed; it refuses a task another session holds or one unfinished tasks depend on, unless force is true. prune: clear stale pending tasks whose creator is gone; a dry run unless dry_run is false. An archived or killed session's claims and assignments go back to the list on their own.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "description": "list, create, claim, assign, finish, release, delete or prune",
        "type": "string"
      },
      "any": {
        "description": "claim: without task_id, take the oldest ready task on the whole list, not only your fleet's; others' tasks are often stale",
        "type": "boolean"
      },
      "assignee": {
        "description": "create, assign: the one session that may claim it: me, or a session id; omit on assign to unassign",
        "type": "string"
      },
      "body": {
        "description": "create: full instruction for whoever claims it, who cannot see this conversation; or name a file in body_file",
        "type": "string"
      },
      "body_file": {
        "description": "create: absolute path of a file holding the instruction, used instead of body",
        "type": "string"
      },
      "created_by": {
        "description": "list: only tasks created by me, or by a session id",
        "type": "string"
      },
      "depends_on": {
        "description": "create: ids of tasks that must finish before this one can be claimed",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "dry_run": {
        "description": "prune: true (default) lists what would be deleted; false deletes it",
        "type": [
          "null",
          "boolean"
        ]
      },
      "fleet": {
        "description": "list: only tasks your fleet created (you, your spawner or parent, and every session under you); the set a claim without task_id takes from",
        "type": "boolean"
      },
      "force": {
        "description": "delete: delete even a task another session holds or one unfinished tasks depend on; its dependents become claimable and the reply names them",
        "type": "boolean"
      },
      "include_body": {
        "description": "list: include each task's full instruction; claim returns it anyway",
        "type": "boolean"
      },
      "include_done": {
        "description": "list: also list finished tasks",
        "type": "boolean"
      },
      "limit": {
        "description": "list: rows to return (default 50, maximum 500); the reply says how many matched",
        "type": "integer"
      },
      "mine": {
        "description": "list: only tasks this session holds or finished",
        "type": "boolean"
      },
      "note": {
        "description": "finish: what came of the work (the outcome, a PR link, what is left), sent to the task's creator; at most 4000 bytes",
        "type": "string"
      },
      "older_than_days": {
        "description": "prune: only tasks created more than this many days ago (default 14)",
        "type": "integer"
      },
      "state": {
        "description": "list: keep only these states: pending, in_progress or done; default pending and in_progress",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "task_id": {
        "description": "task to act on; omit on claim to take the next ready task",
        "type": "string"
      },
      "title": {
        "description": "create: one-line summary, specific enough that another agent knows what done looks like",
        "type": "string"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  },
  "name": "task",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "matched": {
        "description": "list: how many tasks matched the filters, before limit",
        "type": "integer"
      },
      "not_notified": {
        "description": "finish: why the creator was not sent a message",
        "type": "string"
      },
      "notified": {
        "description": "finish: session id of the task's creator, which was sent a message saying the task is done",
        "type": "string"
      },
      "prune": {
        "additionalProperties": false,
        "description": "prune: what was swept, or on a dry run what would be",
        "properties": {
          "count": {
            "description": "how many tasks are in tasks",
            "type": "integer"
          },
          "dry_run": {
            "description": "true when nothing was deleted and tasks is what a prune with dry_run false would delete",
            "type": "boolean"
          },
          "kept": {
            "description": "stale tasks left alone because a task that depends on them is in progress",
            "items": {
              "additionalProperties": false,
              "properties": {
                "assignee": {
                  "description": "session id the task is assigned to; only it may claim the task while it is pending",
                  "type": "string"
                },
                "assignee_name": {
                  "description": "name of the session the task is assigned to",
                  "type": "string"
                },
                "blocked": {
                  "description": "whether unfinished dependencies currently stop this task being claimed",
                  "type": "boolean"
                },
                "blocked_by": {
                  "description": "the dependencies that are not done yet; the rest of depends_on are finished and in nobody's way",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "body": {
                  "description": "full instruction for whoever claims it",
                  "type": "string"
                },
                "created_by": {
                  "description": "session id that created the task; empty on tasks from before creators were recorded",
                  "type": "string"
                },
                "created_by_name": {
                  "description": "name of the session that created the task; empty once its row is gone, when created_by alone names it",
                  "type": "string"
                },
                "depends_on": {
                  "description": "task ids that must be done before this one can be claimed",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "id": {
                  "description": "task id to claim, finish or release",
                  "type": "string"
                },
                "mine": {
                  "description": "whether the calling session holds the claim",
                  "type": "boolean"
                },
                "note": {
                  "description": "what the finisher said came of the task: the outcome, a PR link, what is left; set once it is done, and shortened in text replies unless include_body is set",
                  "type": "string"
                },
                "owner": {
                  "description": "session id holding the claim",
                  "type": "string"
                },
                "owner_name": {
                  "description": "name of the session holding the claim",
                  "type": "string"
                },
                "state": {
                  "description": "pending, in_progress or done",
                  "type": "string"
                },
                "title": {
                  "description": "one-line summary of the work",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "state",
                "blocked",
                "mine"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "older_than_days": {
            "description": "the age in days past which a stale task was swept",
            "type": "integer"
          },
          "tasks": {
            "description": "the stale tasks deleted, or on a dry run those that would be: pending, older than older_than_days, and created by a session that is archived, deleted or was never recorded",
            "items": {
              "additionalProperties": false,
              "properties": {
                "assignee": {
                  "description": "session id the task is assigned to; only it may claim the task while it is pending",
                  "type": "string"
                },
                "assignee_name": {
                  "description": "name of the session the task is assigned to",
                  "type": "string"
                },
                "blocked": {
                  "description": "whether unfinished dependencies currently stop this task being claimed",
                  "type": "boolean"
                },
                "blocked_by": {
                  "description": "the dependencies that are not done yet; the rest of depends_on are finished and in nobody's way",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "body": {
                  "description": "full instruction for whoever claims it",
                  "type": "string"
                },
                "created_by": {
                  "description": "session id that created the task; empty on tasks from before creators were recorded",
                  "type": "string"
                },
                "created_by_name": {
                  "description": "name of the session that created the task; empty once its row is gone, when created_by alone names it",
                  "type": "string"
                },
                "depends_on": {
                  "description": "task ids that must be done before this one can be claimed",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "id": {
                  "description": "task id to claim, finish or release",
                  "type": "string"
                },
                "mine": {
                  "description": "whether the calling session holds the claim",
                  "type": "boolean"
                },
                "note": {
                  "description": "what the finisher said came of the task: the outcome, a PR link, what is left; set once it is done, and shortened in text replies unless include_body is set",
                  "type": "string"
                },
                "owner": {
                  "description": "session id holding the claim",
                  "type": "string"
                },
                "owner_name": {
                  "description": "name of the session holding the claim",
                  "type": "string"
                },
                "state": {
                  "description": "pending, in_progress or done",
                  "type": "string"
                },
                "title": {
                  "description": "one-line summary of the work",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "state",
                "blocked",
                "mine"
              ],
              "type": "object"
            },
            "type": [
              "null",
              "array"
