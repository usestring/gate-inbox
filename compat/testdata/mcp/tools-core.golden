=== create_terminal
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Create a managed terminal for human-visible work such as SSH, not for one-shot local commands or other internal work. It nests under this session unless nest is false, which a group other than this session's needs; a terminal created from a terminal joins it as a sibling under the same agent. The group supplies the inherited directory, and directory set explicitly wins; name labels its row, which is otherwise named after this session. Then call send_terminal with the returned id; use create_session instead for another agent CLI. Call close_terminal when the job is finished and the terminal is not being left for the user.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "existing directory to open; defaults to the selected group's inherited path, then this agent's current directory",
        "type": "string"
      },
      "group": {
        "description": "existing group path for the new terminal; pass an empty string for the root group; defaults to this agent's group",
        "type": [
          "null",
          "string"
        ]
      },
      "name": {
        "description": "name for the terminal's row; omit to name it after this session",
        "type": "string"
      },
      "nest": {
        "description": "when true or omitted, nest under this session, or beside it under the same parent when this session is itself a terminal; false places an un-nested terminal in group",
        "type": [
          "null",
          "boolean"
        ]
      }
    },
    "type": "object"
  },
  "name": "create_terminal",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "directory": {
        "description": "terminal's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the terminal; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "managed terminal session id",
        "type": "string"
      },
      "name": {
        "description": "terminal name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "id of the parent session when nested; empty when un-nested",
        "type": "string"
      },
      "parent_name": {
        "description": "name of the parent session when nested; empty when un-nested",
        "type": "string"
      },
      "running": {
        "description": "whether the terminal currently has a live tmux pane",
        "type": "boolean"
      },
      "status": {
        "description": "stored Gate Inbox status",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "group",
      "directory",
      "status",
      "running",
      "parent_id",
      "parent_name"
    ],
    "type": "object"
  }
}

