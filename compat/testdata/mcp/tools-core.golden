            "type": "boolean"
          },
          "self": {
            "description": "whether this row is the calling session itself",
            "type": "boolean"
          },
          "spawned_by": {
            "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
