=== report_status
{
  "description": "Say where your work stands as you hand control back, as the last thing you do in a turn. done: you have done everything you can, and anything left waits on a review, a blocked merge, another person, or a step only the user can run. waiting: you need the user's answer or decision to go on. blocked: an error or missing access stops you. working: you will carry on without being asked. When done covers work that changed something, note names the check you ran and its result; if no check ran, it says what is unverified. The board reads it to tell the user which sessions they can close; it is not shown to them as a message.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "note": {
        "description": "one line: the evidence for done, or what is left or who it waits on",
        "type": "string"
      },
      "state": {
        "description": "done, waiting (on the user, a review or another person), blocked, or working",
        "type": "string"
      }
    },
    "required": [
      "state"
    ],
    "type": "object"
  },
  "name": "report_status"
}

=== reserve_files
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Declare the files you are about to edit, so another agent working the same repo finds out before both of you change them. Call it when several sessions share one checkout and you are starting on a set of files; a session in a checkout of its own does not need it. The lease is advisory: nothing is blocked, and any overlap with a lease another session holds comes back in conflicts, with the holder to message. It lapses on its own, so an agent that dies never holds the repo. Call release_files when you are done.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "mode": {
        "description": "exclusive (default) means nobody else should edit these paths; shared means others may edit them too",
        "type": "string"
      },
      "note": {
        "description": "what you are doing there, so a conflicting agent knows what it is up against",
        "type": "string"
      },
      "paths": {
        "description": "files or globs you are about to edit, such as internal/store/*.go",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "ttl_minutes": {
        "description": "minutes before the lease lapses on its own, default 30, maximum 240",
        "type": "integer"
      }
    },
    "required": [
      "paths"
    ],
    "type": "object"
  },
  "name": "reserve_files",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "conflicts": {
        "description": "live leases held by other sessions that overlap what was asked for; these are advisory, so nothing is blocked, but the holders should be messaged before editing",
        "items": {
          "additionalProperties": false,
          "properties": {
            "expires_in": {
              "description": "time left before the lease lapses on its own",
              "type": "string"
            },
            "holder": {
              "description": "name of the session holding the lease",
              "type": "string"
            },
            "mine": {
              "description": "whether the calling session holds it",
              "type": "boolean"
            },
            "mode": {
              "description": "exclusive (nobody else edits these paths) or shared (others may read or also edit)",
              "type": "string"
            },
            "note": {
              "description": "what the holder is doing there",
              "type": "string"
            },
            "pattern": {
              "description": "path or glob the lease covers",
              "type": "string"
            },
            "session_id": {
              "description": "session holding the lease",
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "mode",
            "session_id",
            "holder",
            "expires_in",
            "mine"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "reserved": {
        "description": "leases this session now holds",
        "items": {
          "additionalProperties": false,
          "properties": {
            "expires_in": {
              "description": "time left before the lease lapses on its own",
              "type": "string"
            },
            "holder": {
              "description": "name of the session holding the lease",
              "type": "string"
            },
            "mine": {
              "description": "whether the calling session holds it",
              "type": "boolean"
            },
            "mode": {
              "description": "exclusive (nobody else edits these paths) or shared (others may read or also edit)",
              "type": "string"
            },
            "note": {
              "description": "what the holder is doing there",
              "type": "string"
            },
            "pattern": {
              "description": "path or glob the lease covers",
              "type": "string"
            },
            "session_id": {
              "description": "session holding the lease",
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "mode",
            "session_id",
            "holder",
            "expires_in",
            "mine"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "reserved"
    ],
    "type": "object"
  }
}

