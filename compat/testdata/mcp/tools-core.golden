=== message_status
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Check what happened to a message send_session queued: still queued, held, delivered into the agent's prompt, dropped, or answered. Works for a message you sent and for any message sent to a session you spawned, so you can audit what reached your children. Call it when you need to know a handoff landed before you build on it, instead of reading the other agent's screen. Superseded means a later message you sent on the same subject replaced it, and that one is what the agent reads. Held means nothing will type it in as things stand: the recipient's screen is showing a dialog that has to be answered first, or its session is archived or no longer running, and reason says which. Dropped means it never reached the prompt and will not be retried, so send it again.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "message_id": {
        "description": "message id returned by send_session",
        "type": "integer"
      }
    },
    "required": [
      "message_id"
    ],
    "type": "object"
  },
  "name": "message_status",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "body": {
        "type": "string"
      },
      "delivered_at": {
        "description": "RFC3339 time the message reached the prompt",
        "type": "string"
      },
      "interrupt": {
        "description": "sent with interrupt: the recipient's running turn is stopped before it is typed in, unless a dialog is showing",
        "type": "boolean"
      },
      "message_id": {
        "type": "integer"
      },
      "reason": {
        "description": "why the message is in that state, and what to do about it",
        "type": "string"
      },
      "session_id": {
        "description": "session the message was addressed to",
        "type": "string"
      },
      "state": {
        "description": "queued (waiting for the agent to be at rest), superseded (a later message from you on the same subject replaced it), held (nothing will type it in as things stand: the recipient is sitting on a dialog, has a person typing or a draft at its prompt, is archived or not running, and reason says which), delivered (typed into its prompt), dropped (it never reached the prompt and is not retried; reason starts 'recipient ended' when the session it was sent to ended first), or answered (it has since messaged back)",
        "type": "string"
      }
    },
    "required": [
      "message_id",
      "session_id",
      "body",
      "state"
    ],
    "type": "object"
  }
}

=== migrate_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Move a session's conversation to a different agent CLI: starts a new session on that CLI in the same group and directory, whose first prompt points at the source's full transcript on disk and tells it to read it and carry on where the source left off. Use it when a session should continue on another CLI, such as after a usage limit on the one it runs, or to move this session itself by passing its own id. The new session's account is never the caller's to choose: it is the build's extension's choice, or the CLI's own login in a build without one. The source is left as it is, so archive it once the new session has taken over; only claude, codex and opencode sessions with a transcript can be moved.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "kebab-case name for the new session; defaults to the source's name with the tool appended",
        "type": "string"
      },
      "session_id": {
        "description": "session id returned by list_sessions whose conversation moves to another CLI",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the conversation moves to, such as claude, codex or opencode; call list_sessions to see which are in use",
        "type": "string"
      }
    },
    "required": [
      "session_id",
      "tool"
    ],
    "type": "object"
  },
  "name": "migrate_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "account": {
        "description": "named subscription the session runs on; empty is the CLI's own login",
        "type": "string"
      },
      "archived": {
        "description": "whether the session is archived out of the active list",
        "type": "boolean"
      },
      "detached": {
        "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
        "type": "boolean"
      },
      "directory": {
        "description": "session's current working directory, or its launch directory when stopped",
        "type": "string"
      },
      "group": {
        "description": "group path holding the session; empty is the root",
        "type": "string"
      },
      "id": {
        "description": "agent session id",
        "type": "string"
      },
      "model": {
        "description": "model that CLI runs on; empty is the CLI's own default",
        "type": "string"
      },
      "name": {
        "description": "session name shown in Gate Inbox",
        "type": "string"
      },
      "parent_id": {
        "description": "session this row is drawn under on the board; empty for a top-level session",
        "type": "string"
      },
      "permissions": {
        "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "running": {
        "description": "whether the session currently has a live tmux pane",
        "type": "boolean"
      },
      "self": {
        "description": "whether this row is the calling session itself",
        "type": "boolean"
      },
      "spawned_by": {
        "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
        "type": "string"
      },
      "status": {
        "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI the session runs",
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "tool",
      "group",
      "directory",
      "status",
      "running",
      "archived",
      "self"
    ],
    "type": "object"
  }
}

