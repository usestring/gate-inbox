    ],
    "type": "object"
  }
}

=== grant_permission
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "description": "Give a session you spawned one permission your user approved, when its permission system refused a step your brief needs: a command outside the sandbox, a step its auto-mode classifier blocks, a host its sandbox cannot reach. An answer or message you send a child is not its user's approval, so answer_session and send_session cannot do this. Call it first with kind, value or values, and any expires_in_minutes. Unless your user already approved exactly that, it refuses with the exact question to ask: header Approval, options Grant and Don't grant. Ask your user that word for word with your own question tool, then call again with the same arguments; Gate Inbox checks your transcript for their Grant and spends it on this one grant. A step that runs several commands (add, commit, push, merge) is one decision: list every command prefix in values. A prefix is one command; chaining with \u0026\u0026 or ; is refused. Prefer soft_command: it passes a refused step, even one run with dangerouslyDisableSandbox, while the classifier still judges each call. Use rule or unsandboxed_command only when a soft grant is still refused. Wildcards, whole tools, and anything touching settings files, sudo or credentials are always refused. The grant goes into that child's own settings file and the child restarts on its conversation, idle: pass message with the instruction the grant is for, and it is queued with your user's Grant attached. A grant stands for every session the board launches until revoked (revoke true; list_sessions shows grants); asking again for one that stands applies it without a new question. Use expires_in_minutes only for a permission one child should hold for a while. Only Claude Code and pi children take grants. A pi child takes rule and unsandboxed_command only and is not restarted; neither is a child adopted from outside the board, and the result says when part of a grant needs restart true.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "expires_in_minutes": {
        "description": "omit for a standing grant, kept until revoked and never asked for again; 1 to 1440 only for a permission this child alone should hold for a while",
        "type": "integer"
      },
      "kind": {
        "description": "soft_command (preferred: tells the child's auto-mode classifier the user approved commands starting with this exact prefix, sandboxed or not; the classifier still judges each call), rule (one permission rule Tool(pattern), such as Bash(./bin/fetch:*), which skips the classifier for what it matches), unsandboxed_command (an exact prefix that runs outside the sandbox without asking) or domain (one host the sandbox's network proxy lets through)",
        "type": "string"
      },
      "message": {
        "description": "the instruction the grant is for, such as retry the merge; queued for the child with your user's Grant attached",
        "type": "string"
      },
      "restart": {
        "description": "restart the child now even if it is working; otherwise a working child picks the change up at its next restart",
        "type": "boolean"
      },
      "revoke": {
        "description": "true takes a permission back instead; no approval needed",
        "type": "boolean"
      },
      "session_id": {
        "description": "child session to grant to, one this session spawned",
        "type": "string"
      },
      "value": {
        "description": "the command prefix, rule or host, exactly as the approval question names it",
        "type": "string"
      },
      "values": {
        "description": "more of the same kind, approved by the same one question: every command one step runs, such as the commit, the push and the merge",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "session_id",
      "kind"
    ],
    "type": "object"
  },
  "name": "grant_permission",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "type": "string"
      },
      "approval_question": {
        "type": "string"
      },
      "attestation": {
        "type": "string"
      },
      "grant": {
        "additionalProperties": false,
        "properties": {
          "by": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
