=== wait_for_session
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Park until a session you are waiting on stops working, instead of calling read_session in a loop. Call it after handing an agent a task when your next step depends on its result. For a fan-out pass children true, or several session_ids: one call parks on the whole set and returns the moment any one of them arrives, so never wait on children one at a time. By default it returns once a session reaches any state that means it stopped (finished, waiting, idle, errored or dead); pass until to wait for particular states. It counts from your own handoff. While a message you sent that session is still queued, its state describes the turn before, so the wait carries on until that message goes in and its turn ends. A timeout is a normal answer, not a failure: the result carries reached false and the actual state, and outcome says whether it reached, timed_out or died. standing carries every waited-on session with its own outcome, so use that rather than a follow-up list_sessions, then read_session on whichever one moved.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "children": {
        "description": "park on every session you spawned, which is what a fan-out wants; give this instead of session_id or session_ids, never alongside them",
        "type": "boolean"
      },
      "session_id": {
        "description": "one session id returned by list_sessions or create_session; for a fan-out use children, or session_ids",
        "type": "string"
      },
      "session_ids": {
        "description": "several session ids to park on at once; the call ends as soon as any one of them arrives and reports where all of them stand",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "timeout_s": {
        "description": "seconds to wait before giving up, default 50, maximum 120; your own client may cut the call short before this",
        "type": "integer"
      },
      "until": {
        "description": "states that end the wait; defaults to every state that means a session stopped working (finished, waiting, idle, errored, dead). Valid values: starting, working, waiting, finished, idle, errored, dead",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "type": "object"
  },
  "name": "wait_for_session",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "manager_awake": {
        "description": "whether Gate Inbox is running; session status only advances while it is, so a wait against a closed manager can only ever observe dead",
        "type": "boolean"
      },
      "outcome": {
        "description": "reached (one of them arrived at an awaited state), died (one died and none arrived), or timed_out",
        "type": "string"
      },
      "reached": {
        "description": "true when at least one waited-on session reached one of the awaited states",
        "type": "boolean"
      },
      "session": {
        "additionalProperties": false,
        "description": "the session that decided this call: the one that arrived, or died, or the single target that did neither",
        "properties": {
          "account": {
            "description": "named subscription the session runs on; empty is the CLI's own login",
            "type": "string"
          },
          "archived": {
            "description": "whether the session is archived out of the active list",
            "type": "boolean"
          },
          "detached": {
            "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
            "type": "boolean"
          },
          "directory": {
            "description": "session's current working directory, or its launch directory when stopped",
            "type": "string"
          },
          "group": {
            "description": "group path holding the session; empty is the root",
            "type": "string"
          },
          "id": {
            "description": "agent session id",
            "type": "string"
          },
          "model": {
            "description": "model that CLI runs on; empty is the CLI's own default",
            "type": "string"
          },
          "name": {
            "description": "session name shown in Gate Inbox",
            "type": "string"
          },
          "parent_id": {
            "description": "session this row is drawn under on the board; empty for a top-level session",
            "type": "string"
          },
          "permissions": {
            "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          },
          "running": {
            "description": "whether the session currently has a live tmux pane",
            "type": "boolean"
          },
          "self": {
            "description": "whether this row is the calling session itself",
            "type": "boolean"
          },
          "spawned_by": {
            "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
            "type": "string"
          },
          "status": {
            "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
            "type": "string"
          },
          "tool": {
            "description": "agent CLI the session runs",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "tool",
          "group",
          "directory",
          "status",
          "running",
          "archived",
          "self"
        ],
        "type": "object"
      },
      "standing": {
        "description": "where every waited-on session stood when this returned, so a fan-out never needs a follow-up list to find out what it is still waiting for",
        "items": {
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "description": "reached (it arrived at an awaited state), died (its pane is gone and dead was not among them), or timed_out (it had not arrived yet; session.status is what it was doing)",
              "type": "string"
            },
            "session": {
              "additionalProperties": false,
              "description": "the waited-on session as it stood when the wait returned",
              "properties": {
                "account": {
                  "description": "named subscription the session runs on; empty is the CLI's own login",
                  "type": "string"
                },
                "archived": {
                  "description": "whether the session is archived out of the active list",
                  "type": "boolean"
                },
                "detached": {
                  "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
                  "type": "boolean"
                },
                "directory": {
                  "description": "session's current working directory, or its launch directory when stopped",
                  "type": "string"
                },
                "group": {
                  "description": "group path holding the session; empty is the root",
                  "type": "string"
                },
                "id": {
                  "description": "agent session id",
                  "type": "string"
                },
                "model": {
                  "description": "model that CLI runs on; empty is the CLI's own default",
                  "type": "string"
                },
                "name": {
                  "description": "session name shown in Gate Inbox",
                  "type": "string"
                },
                "parent_id": {
                  "description": "session this row is drawn under on the board; empty for a top-level session",
                  "type": "string"
                },
                "permissions": {
                  "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
                  "items": {
                    "type": "string"
                  },
                  "type": [
                    "null",
                    "array"
                  ]
                },
                "running": {
                  "description": "whether the session currently has a live tmux pane",
                  "type": "boolean"
                },
                "self": {
                  "description": "whether this row is the calling session itself",
                  "type": "boolean"
                },
                "spawned_by": {
                  "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
                  "type": "string"
                },
                "status": {
                  "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
                  "type": "string"
                },
                "tool": {
                  "description": "agent CLI the session runs",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "tool",
                "group",
                "directory",
                "status",
                "running",
                "archived",
                "self"
              ],
              "type": "object"
            }
          },
          "required": [
            "session",
            "outcome"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "waited": {
        "description": "how long the wait lasted",
        "type": "string"
      }
    },
    "required": [
      "session",
      "reached",
      "outcome",
      "waited",
      "manager_awake",
      "standing"
    ],
    "type": "object"
  }
}
