            },
            "mine": {
              "description": "whether the calling session holds it",
              "type": "boolean"
            },
            "mode": {
              "description": "exclusive (nobody else edits these paths) or shared (others may read or also edit)",
              "type": "string"
            },
            "note": {
              "description": "what the holder is doing there",
              "type": "string"
            },
            "pattern": {
              "description": "path or glob the lease covers",
              "type": "string"
            },
            "session_id": {
              "description": "session holding the lease",
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "mode",
            "session_id",
            "holder",
            "expires_in",
            "mine"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "reservations"
    ],
    "type": "object"
  }
}

=== list_sessions
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Call first whenever the work involves another agent: before delegating, before reporting on the fleet, and to find a session's id. Lists the board's agent sessions (separate CLI processes, not your subagents) with ids, names, CLIs, groups, directories and statuses, and marks this session's row. hibernating means stopped to free memory: a message wakes it, so send to it rather than reviving it. delegating means its turn ended while its children still run; background means its turn ended with a shell or task still running. Send to the session that already owns the work rather than calling create_session for it. Filter rather than reading the whole board: parent \"me\" for your children, status by state; archived rows are left out unless asked for.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "include_archived": {
        "description": "also list archived rows, most of a long-lived board; only when looking for one to restore",
        "type": "boolean"
      },
      "include_text": {
        "description": "false returns the rows only in the structured result, with a one-line count as text",
        "type": [
          "null",
          "boolean"
        ]
      },
      "limit": {
        "description": "rows to return (default 50, maximum 500); the reply says how many matched",
        "type": "integer"
      },
      "parent": {
        "description": "\"me\" for the sessions you spawned; omit for every session",
        "type": "string"
      },
      "status": {
        "description": "keep only these states: starting, working, waiting, delegating, background, finished, idle, errored, hibernating or dead",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "type": "object"
  },
  "name": "list_sessions",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "matched": {
        "description": "how many sessions matched the filters, before limit",
        "type": "integer"
      },
      "returned": {
        "description": "how many rows are in sessions",
        "type": "integer"
      },
      "sessions": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "account": {
              "description": "named subscription the session runs on; empty is the CLI's own login",
              "type": "string"
            },
            "archived": {
              "description": "whether the session is archived out of the active list",
              "type": "boolean"
            },
            "children_skip_permissions": {
              "description": "sessions it spawns run with their permission prompts off unless the spawn says otherwise",
              "type": "boolean"
            },
            "detached": {
              "description": "whether this session was created detached (nest false): its creator, in spawned_by, is told nothing of its questions or finishes and cannot answer its dialogs, and the two talk only through send_session",
              "type": "boolean"
            },
            "directory": {
              "description": "session's current working directory, or its launch directory when stopped",
              "type": "string"
            },
            "group": {
              "description": "group path holding the session; empty is the root",
              "type": "string"
            },
            "id": {
              "description": "agent session id",
              "type": "string"
            },
            "model": {
              "description": "model that CLI runs on; empty is the CLI's own default",
              "type": "string"
            },
            "muted": {
              "description": "whether the operator has muted this session out of their triage queue until it is unmuted",
              "type": "boolean"
            },
            "name": {
              "description": "session name shown in Gate Inbox",
              "type": "string"
            },
            "parent_id": {
              "description": "session this row is drawn under on the board; empty for a top-level session",
              "type": "string"
            },
            "permissions": {
              "description": "permissions its spawner granted it with grant_permission on its user's approval, each as kind and value; revoke one with grant_permission revoke true",
              "items": {
                "type": "string"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "released_tasks": {
              "description": "how many tasks this archive or kill handed back to pending: claims this session (and, on an archive, everything filed with it) held in progress, which any agent can now claim",
              "type": "integer"
            },
            "running": {
              "description": "whether the session currently has a live tmux pane",
              "type": "boolean"
            },
            "self": {
              "description": "whether this row is the calling session itself",
              "type": "boolean"
            },
            "skip_permissions": {
              "description": "the session runs with its CLI's permission prompts off",
              "type": "boolean"
            },
            "spawned_by": {
              "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children unless it is detached; empty for a session nobody spawned",
              "type": "string"
            },
            "status": {
              "description": "Gate Inbox status: starting, working, waiting, delegating, background, finished, idle, errored or dead",
              "type": "string"
            },
            "tool": {
              "description": "agent CLI the session runs",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "tool",
            "group",
            "directory",
            "status",
            "running",
            "archived",
            "muted",
            "self"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "truncated": {
        "description": "true when limit left matching sessions out; narrow parent or status, or raise limit",
        "type": "boolean"
      }
    },
    "required": [
      "sessions",
      "matched",
      "returned",
      "truncated"
    ],
    "type": "object"
  }
}

