            "archived",
            "sessions"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "groups"
    ],
    "type": "object"
  }
}

=== list_models
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Call before passing a model to create_session, to find the names that CLI actually accepts instead of guessing one. Names one CLI's models when tool is given, and every configured CLI that can answer when it is omitted, saying for each where the answer came from: the CLI's own listing command where it has one, otherwise the names written into the config, which may lag. A CLI refuses a model it does not know, so a guessed name is not a worse answer but a session that dies at launch; a CLI with no model flag says so here rather than at spawn time. Long lists are capped and say how many were left out, so pass filter when looking for a family by name.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "filter": {
        "description": "keep only the model names holding this text, case-insensitively (e.g. \"muse\", \"sonnet\"); omit for the whole list, which is capped and reports how many it left out",
        "type": "string"
      },
      "tool": {
        "description": "agent CLI to ask, such as claude, codex or opencode; omit to list every configured CLI that can answer",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "list_models"
}

=== list_reservations
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "See which files the other sessions are working on right now. Call it before editing shared code, or when planning who takes which part of a change.",
  "inputSchema": {
    "additionalProperties": false,
    "type": "object"
  },
  "name": "list_reservations",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "reservations": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "expires_in": {
              "description": "time left before the lease lapses on its own",
              "type": "string"
            },
            "holder": {
              "description": "name of the session holding the lease",
              "type": "string"
            },
            "mine": {
              "description": "whether the calling session holds it",
              "type": "boolean"
            },
            "mode": {
              "description": "exclusive (nobody else edits these paths) or shared (others may read or also edit)",
              "type": "string"
            },
            "note": {
              "description": "what the holder is doing there",
              "type": "string"
            },
            "pattern": {
              "description": "path or glob the lease covers",
              "type": "string"
            },
            "session_id": {
              "description": "session holding the lease",
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "mode",
            "session_id",
            "holder",
            "expires_in",
            "mine"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "reservations"
    ],
    "type": "object"
  }
}

=== list_sessions
{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Call first whenever the work involves another agent: before delegating, before reporting what the fleet is doing, and to find the id of a session to read, prompt, revive, kill or archive. Lists every agent session Gate Inbox knows with ids, names, CLIs, groups, directories, statuses (starting, working, waiting, finished, idle, errored, dead) and which row is this session. These are separate CLI processes running on the user's machine, each with its own context and its own conversation, and any CLI the user configured: Claude Code, Codex, OpenCode and others, not only Claude. They are not this conversation's subagents, they outlive this conversation, and the user watches them all in one list; nothing else this session can call reports them. Reuse a relevant idle session instead of creating another; otherwise call create_session. Ask for what you need rather than the board: parent \"me\" is your own children, status narrows to the states you care about, and archived rows are left out unless you ask for them. An unfiltered board is mostly history and can run to hundreds of kilobytes, so a parent checking on its fan-out should be calling it with parent \"me\".",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "include_archived": {
        "description": "also list sessions archived out of the active list, which on a long-lived board are most of the table; pass it only when looking for a row to restore with archive_session",
        "type": "boolean"
      },
      "include_text": {
        "description": "when false, the readable rendering is replaced by a one-line count and the rows come back only in the structured result, which halves the reply; omit or true for both renderings",
        "type": [
          "null",
          "boolean"
        ]
      },
      "limit": {
        "description": "how many rows to return (default 50, maximum 500); the reply says how many matched, so a truncated one is never silent",
        "type": "integer"
      },
      "parent": {
        "description": "keep only the sessions this one spawned; pass \"me\" for this session's own children, which is the fan-out it is steering; omit for every session whoever spawned it",
        "type": "string"
      },
      "status": {
        "description": "keep only sessions in these states: starting, working, waiting, finished, idle, errored or dead; omit for every state",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "type": "object"
  },
  "name": "list_sessions",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "matched": {
        "description": "how many sessions matched the filters, before limit",
        "type": "integer"
      },
      "returned": {
        "description": "how many rows are in sessions",
        "type": "integer"
      },
      "sessions": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "account": {
              "description": "named subscription the session runs on; empty is the CLI's own login",
              "type": "string"
            },
            "archived": {
              "description": "whether the session is archived out of the active list",
              "type": "boolean"
            },
            "directory": {
              "description": "session's current working directory, or its launch directory when stopped",
              "type": "string"
            },
            "group": {
              "description": "group path holding the session; empty is the root",
              "type": "string"
            },
            "id": {
              "description": "agent session id",
              "type": "string"
            },
            "model": {
              "description": "model that CLI runs on; empty is the CLI's own default",
              "type": "string"
            },
            "name": {
              "description": "session name shown in Gate Inbox",
              "type": "string"
            },
            "parent_id": {
              "description": "session this row is drawn under on the board; empty for a top-level session",
              "type": "string"
            },
            "running": {
              "description": "whether the session currently has a live tmux pane",
              "type": "boolean"
            },
            "self": {
              "description": "whether this row is the calling session itself",
              "type": "boolean"
            },
            "spawned_by": {
              "description": "session that spawned this one, which is the only session that can answer its questions or reach it with send_children; empty for a session nobody spawned",
              "type": "string"
            },
            "status": {
              "description": "Gate Inbox status: starting, working, waiting, finished, idle, errored or dead",
              "type": "string"
            },
            "tool": {
              "description": "agent CLI the session runs",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "tool",
            "group",
            "directory",
            "status",
            "running",
            "archived",
            "self"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "truncated": {
        "description": "true when limit left matching sessions out; narrow parent or status, or raise limit",
        "type": "boolean"
      }
    },
    "required": [
      "sessions",
      "matched",
      "returned",
      "truncated"
    ],
    "type": "object"
  }
}

