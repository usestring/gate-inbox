[claude]
status_source = "claude-hooks"
default_status = "idle"
type_ahead = true
activity_cutoff = "(?m)^❯"
input_line = ""
turn_end = "^[✻✳✶✽✢·✦✧+*] \\S+ for \\d.*$"
chrome_line = "^\\s*[─q]{4,}.*$|^[\\s─q]*$|^\\s*✔ Update installed\\b.*$"
blocked_line = "Interrupted ·"
trailing_note = "^※"
busy_line = "^[✻✳✶✽✢·✦✧+*] Waiting for \\d+ (?:background agents?|dynamic workflows?)"
limit_line = "(?m)You've hit your .+limit"
arrow_dialog_line = "(?i)\\x{B7} [^\\x{B7}\\n]*(?:Arrow keys|\\x{2190}|\\x{2192})[^\\x{B7}\\n]* to navigate\\b"
dialog_step_row = "^[ \\x{A0}]*\\x{2190}[ \\x{A0}].*[ \\x{A0}]\\x{2192}[ \\x{A0}]*$"
dialog_step_entry = "[\\x{2610}-\\x{2612}\\x{2714}]"
scrolled_line = "Jump to bottom \\(ctrl\\+End\\)"
jump_to_bottom_key = "C-End"
echo_budget = "0s"
interrupt_keys = ["Escape"]
rules[0] waiting "(?m)^[ \\x{A0}\\x{2502}|]*(?:[^\\n]*[,\\x{B7}][ \\x{A0}]*)?Enter to confirm(?:[ \\x{A0}]*[,\\x{B7}][^\\n]*)?[ \\x{A0}\\x{2502}|]*$"
rules[1] waiting "(?m)^[ \\x{A0}]*❯[ \\x{A0}]+\\d+\\."
rules[2] waiting "(?m)^[ \\x{A0}]*Enter to select \\x{B7} (?:[^\\x{B7}\\n]+\\x{B7} )*Esc to cancel[ \\x{A0}]*$"
rules[3] waiting "(?m)^[ \\x{A0}]*Ready to submit your answers\\?[ \\x{A0}]*$"
rules[4] working "(?m)^[✻✳✶✽✢·✦✧+*] \\S+… \\("
rules[5] working "esc to interrupt"
rules[6] errored "(?im)^\\s*error:"

[codex]
status_source = ""
default_status = "idle"
type_ahead = false
activity_cutoff = "(?m)^(?:[ \\t\\x{2800}-\\x{28ff}]*\\n)*›"
input_line = "^›"
turn_end = "(?m)^(?:─+ Worked for [\\dhms. ]+─.*|─{20,}\\s*)$"
chrome_line = "^\\s*─*\\s*$|^⚠ (?:The \\S+ MCP server is not logged in\\. Run \\x60codex mcp login \\S+\\x60\\.|MCP startup incomplete \\(failed: [^)]+\\))$"
blocked_line = ""
trailing_note = ""
busy_line = ""
limit_line = "(?m)You've hit your usage limit"
arrow_dialog_line = ""
dialog_step_row = ""
dialog_step_entry = ""
scrolled_line = ""
jump_to_bottom_key = ""
echo_budget = "90ms"
interrupt_keys = []
rules[0] waiting "(?m)^\\s*›\\s+\\d+\\."
rules[1] waiting "(?m)Press enter to (confirm|continue)\\b"
rules[2] waiting "(?m)enter to submit answer\\b"
rules[3] working "(?m)^[ \\t]*(?:• )?[^\\n]*\\([\\dhms. ]+ [•·] esc to interrupt\\)(?: · [^\\n]*)?[ \\t]*\\n(?:[ \\t]+└[^\\n]*\\n(?:[ \\t]{4}[^\\n]*\\n)*)?[ \\t\\n]*\\z"
rules[4] errored "(?im)^\\s*■.*\\berror\\b"

[opencode]
status_source = ""
default_status = "idle"
type_ahead = false
activity_cutoff = "(?m)^\\s*╹"
input_line = "^[ \\x{A0}]*┃"
turn_end = "^ *[^ ┃].*· \\d+(?:\\.\\d+)?[hms](?: \\d+[hms])*(?: · [\\d.]+ tok/s)?(?: {2,}.*)?$"
chrome_line = "^\\s*(┃.*)?$|^ {40,}\\S.*$"
blocked_line = ""
trailing_note = ""
busy_line = ""
limit_line = "(?i)requires more credits|(?:Usage|Free|Go) limit reached"
arrow_dialog_line = "\\x{21C6} select"
dialog_step_row = ""
dialog_step_entry = ""
scrolled_line = ""
jump_to_bottom_key = ""
echo_budget = "0s"
interrupt_keys = []
rules[0] waiting "\\x{25B3} Permission required"
rules[1] waiting "\\x{21C6} select\\s+enter confirm"
rules[2] waiting "(?m)^.*\\benter (?:submit|toggle|confirm)[ \\x{A0}]+esc dismiss[ \\x{A0}]*$"
rules[3] errored "(?i)requires more credits"
rules[4] errored "(?im)^\\s*error\\b"
rules[5] working "esc interrupt"

[terminal]
status_source = ""
default_status = "idle"
type_ahead = false
activity_cutoff = ""
input_line = ""
turn_end = ""
chrome_line = ""
blocked_line = ""
trailing_note = ""
busy_line = ""
limit_line = ""
arrow_dialog_line = ""
dialog_step_row = ""
dialog_step_entry = ""
scrolled_line = ""
jump_to_bottom_key = ""
echo_budget = "0s"
interrupt_keys = []

