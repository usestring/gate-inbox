{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // The tests and their fakes run under bun, which supplies bun:test and
  // bun:sqlite, and no tsc project here can see either. Excluded so a
  // typecheck reports the Worker's own errors rather than imports it was
  // never going to resolve; none of these files reaches the bundle.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/fake-*.ts"]
}
